class_name AmbiencePlayer
extends AudioStreamPlayer
## Looping background bed for a location.
##
## The placeholder WAVs in assets/audio are generated by tools/ and carry no
## authored loop points, and this milestone does not commit per-machine .import
## settings. Looping is therefore enabled on a duplicated stream at runtime,
## which keeps the audio pipeline portable.

## Volume the bed fades in to, in dB.
@export var target_db: float = -20.0
@export var fade_in_seconds: float = 2.5


func _ready() -> void:
	var wav := stream as AudioStreamWAV
	if wav != null:
		var looped := wav.duplicate() as AudioStreamWAV
		if looped == null:
			push_error("AmbiencePlayer '%s': could not copy the WAV stream." % name)
			return
		looped.loop_mode = AudioStreamWAV.LOOP_FORWARD
		looped.loop_begin = 0
		looped.loop_end = int(looped.get_length() * float(looped.mix_rate))
		stream = looped
	elif stream != null:
		push_warning("AmbiencePlayer '%s': stream is not a WAV, so it will not loop." % name)

	volume_db = -60.0
	play()
	var tween := create_tween()
	tween.tween_property(self, "volume_db", target_db, fade_in_seconds)
