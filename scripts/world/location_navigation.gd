class_name LocationNavigation
extends NavigationRegion3D
## Bakes a navigation mesh for the location it belongs to.
##
## Each location scene owns exactly one of these nodes as a direct child of the
## location root. The mesh is baked **at load time from the location's own static
## colliders**, not authored by hand and not shared between scenes: the classroom's
## desks are not the street's walls, and a mesh baked for one room is a mesh that
## lies about the next.
##
## Why runtime baking instead of a checked-in `.res`:
##
## - the locations are greybox box tables, several of them generated by
##   `tools/build_outdoor_locations.py`; a stored mesh would go stale the moment a box
##   moved, and nothing would notice;
## - baking here is deterministic, takes a few milliseconds for a room of this size,
##   and fails loudly (`get_polygon_count() == 0`) if the geometry stops being
##   walkable.
##
## The parsing rules are deliberately conservative: only static colliders on the world
## layer are considered, with an agent radius wide enough that the player does not clip
## corners through walls.

signal navigation_baked(success: bool)

## Bake as soon as the location is in the tree. Turn off for a scene whose geometry is
## added later by gameplay code.
@export var bake_on_ready: bool = true
## The player's capsule radius plus a margin. A navmesh narrower than the body makes
## the character grind along walls.
@export var agent_radius: float = 0.4
## Kept just under the player's height so low clearance is not marked walkable.
@export var agent_height: float = 1.8
## Steps this tall count as walkable, so a kerb or a fire step is a ramp, not a wall.
@export var agent_max_climb: float = 0.4
@export_range(1.0, 89.0, 1.0) var agent_max_slope: float = 45.0
## Which physics layer the walkable world lives on.
@export_flags_3d_physics var geometry_collision_mask: int = 1

var _baked := false
var _polygon_count := 0
var _bake_error: String = ""
var _map_region_count: int = 0


func _ready() -> void:
	add_to_group("location_navigation")
	if bake_on_ready:
		# Deferred: while this node's _ready runs, its siblings are still entering the
		# tree, so the geometry would be parsed half-built.
		call_deferred("bake_region")


## Bakes the mesh now. Returns false when the geometry produced no walkable polygons,
## which is a content error, not a runtime hiccup.
func bake_region() -> bool:
	var root := get_parent()
	if root == null:
		_bake_error = "the region has no parent to bake from"
		navigation_baked.emit(false)
		return false
	var mesh: NavigationMesh = navigation_mesh
	if mesh == null:
		mesh = NavigationMesh.new()
	_configure(mesh)
	var source := NavigationMeshSourceGeometryData3D.new()
	NavigationServer3D.parse_source_geometry_data(mesh, source, root)
	NavigationServer3D.bake_from_source_geometry_data(mesh, source)
	navigation_mesh = mesh
	_polygon_count = mesh.get_polygon_count()
	_baked = _polygon_count > 0
	_map_region_count = get_map_region_count()
	if not _baked:
		_bake_error = "no walkable polygons were produced by '%s'" % root.name
	# The map reads the region on its own schedule; force one update so the first
	# path query after a load is answered instead of returning an empty path.
	NavigationServer3D.map_force_update(get_navigation_map())
	_map_region_count = get_map_region_count()
	if _baked and _map_region_count <= 0:
		# A mesh with polygons that never reached the map is invisible to every path
		# query. That is a wiring problem, and it must not look like an empty room.
		_bake_error = (
			"the region did not register with the navigation map (mesh has %d polygons)"
			% _polygon_count
		)
		push_error("LocationNavigation: %s" % _bake_error)
	navigation_baked.emit(_baked)
	return _baked


func is_baked() -> bool:
	return _baked


func get_polygon_count() -> int:
	return _polygon_count


func get_bake_error() -> String:
	return _bake_error


## How many regions the navigation map holds. One means this location's mesh reached
## the map; zero means every path query will come back empty however good the mesh is.
func get_map_region_count() -> int:
	var map := get_navigation_map()
	if not map.is_valid():
		return 0
	return NavigationServer3D.map_get_regions(map).size()


## A point on this region's navigation mesh, or `fallback` when the mesh is empty.
func project_point(point: Vector3, fallback: Vector3 = Vector3.ZERO) -> Vector3:
	if not _baked:
		return fallback
	return NavigationServer3D.map_get_closest_point(get_navigation_map(), point)


func _configure(mesh: NavigationMesh) -> void:
	mesh.geometry_parsed_geometry_type = NavigationMesh.PARSED_GEOMETRY_STATIC_COLLIDERS
	mesh.geometry_collision_mask = geometry_collision_mask
	mesh.agent_radius = agent_radius
	mesh.agent_height = agent_height
	mesh.agent_max_climb = agent_max_climb
	mesh.agent_max_slope = agent_max_slope
	# A navigation map refuses a region whose mesh uses different cell dimensions, and
	# a refused region looks exactly like a room with no floor. The map's values are
	# copied onto the mesh, and the map is asked to use the mesh's values as well, so
	# the two agree whichever side the engine takes as authoritative.
	var map := get_navigation_map()
	if not map.is_valid():
		return
	if NavigationServer3D.has_method("map_set_cell_size") and mesh.cell_size > 0.0:
		NavigationServer3D.map_set_cell_size(map, mesh.cell_size)
	if NavigationServer3D.has_method("map_set_cell_height") and mesh.cell_height > 0.0:
		NavigationServer3D.map_set_cell_height(map, mesh.cell_height)
	if NavigationServer3D.has_method("map_get_cell_size"):
		var map_cell_size: float = NavigationServer3D.map_get_cell_size(map)
		if map_cell_size > 0.0:
			mesh.cell_size = map_cell_size
	if NavigationServer3D.has_method("map_get_cell_height"):
		var map_cell_height: float = NavigationServer3D.map_get_cell_height(map)
		if map_cell_height > 0.0:
			mesh.cell_height = map_cell_height
