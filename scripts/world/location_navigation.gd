class_name LocationNavigation
extends NavigationRegion3D
## Bakes a navigation mesh for the location it belongs to.
##
## Each location scene owns exactly one of these nodes as a direct child of the
## location root. The mesh is baked **at load time from the location's own static
## colliders**, not authored by hand and not shared between scenes: the classroom's
## desks are not the street's walls, and a mesh baked for one room is a mesh that
## lies about the next.
##
## Why runtime baking instead of a checked-in `.res`:
##
## - the locations are greybox box tables, several of them generated by
##   `tools/build_outdoor_locations.py`; a stored mesh would go stale the moment a box
##   moved, and nothing would notice;
## - baking here is deterministic, takes a few milliseconds for a room of this size,
##   and fails loudly (`get_polygon_count() == 0`) if the geometry stops being
##   walkable.
##
## The parsing rules are deliberately conservative: only static colliders on the world
## layer and two reserved navigation-only layers are considered, with an agent radius wide
## enough that the player does not clip corners through walls. Visible outdoor stair blocks
## use layer 4 so Recast sees them and they still occlude sight; invisible thin treads use
## layer 5, which only the bake sees. The player rides one continuous ramp collider.

signal navigation_baked(success: bool)

## Bake as soon as the location is in the tree. Turn off for a scene whose geometry is
## added later by gameplay code.
@export var bake_on_ready: bool = true
## The player's capsule radius (0.35 m) plus a margin. A navmesh narrower than the body
## makes the character grind along walls.
##
## Every one of these numbers is converted to whole voxels before it is used, and the
## conversion is not the identity: `agent_height` and `agent_radius` are *ceiled*, and
## `agent_max_climb` is *floored* (`NavMeshGenerator3D`, which warns about each one). The
## property is a wish; the bake uses the voxel it lands on. So the values here are the ones
## that land exactly on the 0.25 m grid the bake uses, which is what the bake was already
## buying: 0.40 m of radius was being used as 0.50, 1.80 m of headroom as 2.00, and
## 0.30 m of climb as 0.25 — that last one is 3 cm below the street's kerb, and that is why
## the pavement behind the kerb was a separate island from the road.
##
##                  asked    voxels (0.25 m)   used
##   agent_radius   0.50     2                 0.50   (capsule 0.35 + margin)
##   agent_height   2.00     8                 2.00   (capsule 1.80 + margin)
##   agent_max_climb 0.25    1                 0.25   (the body's step)
##
## `tests/step_up_test.gd` measures what the bake used, not what was asked.
@export var agent_radius: float = 0.5
## The player's height plus a margin, so low clearance is not marked walkable.
@export var agent_height: float = 2.0
## Steps this tall count as walkable, so a kerb or a fire step is a ramp, not a wall.
## Equal to the body's `max_step_height`: a mesh that promises a taller step than the body
## can take produces routes the character walks into and grinds against, and a mesh that
## promises less produces routes around a kerb the player could have stepped over.
@export var agent_max_climb: float = 0.25
@export_range(1.0, 89.0, 1.0) var agent_max_slope: float = 45.0
## World geometry plus bits 8 and 16 (physics layers 4 and 5). Layer 4 is for visible
## stair blocks that still occlude sight; layer 5 is for invisible bake-only treads.
@export_flags_3d_physics var geometry_collision_mask: int = 25

var _baked := false
var _polygon_count := 0
var _bake_error: String = ""
var _map_region_count: int = 0
var _source_face_count: int = 0

## Timing of the last bake, in microseconds: the whole bake and the geometry collection
## inside it. Measured once per bake — a bake happens when a location enters the tree, not
## per frame — so the numbers describe the load, never the running game.
var _bake_usec: int = 0
var _collect_usec: int = 0

## How many physics frames a freshly baked region keeps handing its mesh over to the map
## before it declares the map out of sync. The server parses a region's mesh and rebuilds
## the map on its own schedule, and a map that has not rebuilt yet answers queries from
## whatever it held before — which, right after a location swap, is the room that was just
## freed. That is not a rare state: it is the frame the player arrives on.
const SYNC_CHECK_FRAMES := 12
## How far the map's answer for a vertex of this region's own mesh may sit from that vertex
## before the map is answering from a different surface. A vertex is on the mesh, so the
## only distance here is the bake's own offset from the collider it came from — millimetres.
const SYNC_PROBE_TOLERANCE := 0.25
## How many of the mesh's vertices are offered to the map as probes. One vertex is not
## enough: every location is a greybox room built around its own origin, so two rooms
## overlap in world space and a single corner can be answered by the room next door. A
## spread of vertices is answered only by the mesh whose vertices they are.
const SYNC_PROBES := 6

var _sync_checks_left: int = 0

## The map's iteration id the last time this region handed its mesh over, and the id the
## map is on now. Both are reported: the difference is the server's own account of whether
## it has processed the change.
var _iteration_at_handover: int = 0
var _iteration_last_seen: int = 0
## Set when the map never came back with this region's geometry. Not a bake error — the
## mesh is fine and the wiring is fine; the *map* is the thing that never caught up.
var _sync_error: String = ""


func _ready() -> void:
	add_to_group("location_navigation")
	if bake_on_ready:
		# Deferred: while this node's _ready runs, its siblings are still entering the
		# tree, so the geometry would be parsed half-built.
		call_deferred("bake_region")


## Bakes the mesh now. Returns false when the geometry produced no walkable polygons,
## which is a content error, not a runtime hiccup.
func bake_region() -> bool:
	var started := Time.get_ticks_usec()
	var root := get_parent()
	if root == null:
		_bake_error = "the region has no parent to bake from"
		_bake_usec = Time.get_ticks_usec() - started
		_report("")
		navigation_baked.emit(false)
		return false
	# Bake into a copy, never into the resource the scene was packed with. A `.tscn` shares
	# its sub-resources between every instance of that scene, so baking in place writes one
	# instance's floor into the mesh another instance is using — which happens the first time
	# a location is entered while an instance of it is still loaded, and looks exactly like a
	# room whose navigation silently stopped answering.
	var packed_mesh := navigation_mesh
	var mesh: NavigationMesh = null
	if packed_mesh != null:
		mesh = packed_mesh.duplicate() as NavigationMesh
	if mesh == null:
		mesh = NavigationMesh.new()
	_configure(mesh)
	var source := NavigationMeshSourceGeometryData3D.new()
	var collect_started := Time.get_ticks_usec()
	_source_face_count = _collect_geometry(root, source)
	_collect_usec = Time.get_ticks_usec() - collect_started
	NavigationServer3D.bake_from_source_geometry_data(mesh, source)
	navigation_mesh = mesh
	_polygon_count = mesh.get_polygon_count()
	_baked = _polygon_count > 0
	_map_region_count = get_map_region_count()
	if not _baked:
		_bake_error = "no walkable polygons were produced by '%s'" % root.name
	# The map reads the region on its own schedule; force one update so the first
	# path query after a load is answered instead of returning an empty path.
	NavigationServer3D.map_force_update(get_navigation_map())
	_map_region_count = get_map_region_count()
	if _baked:
		_sync_error = ""
		_iteration_at_handover = get_map_iteration_id()
		_sync_checks_left = SYNC_CHECK_FRAMES
		call_deferred("_watch_synchronization")
	if _baked and _map_region_count <= 0:
		# A mesh with polygons that never reached the map is invisible to every path
		# query. That is a wiring problem, and it must not look like an empty room.
		_bake_error = (
			"the region did not register with the navigation map (mesh has %d polygons)"
			% _polygon_count
		)
		push_error("LocationNavigation: %s" % _bake_error)
	_bake_usec = Time.get_ticks_usec() - started
	_report(String(root.name))
	navigation_baked.emit(_baked)
	return _baked


## The navigation map's iteration id, or 0 when there is no map to ask.
##
## The server bumps this every time it rebuilds a map. An id of zero means the map has not
## been synchronized even once, and every query against it before that prints
## "navigation map query failed because it was made before first map synchronization" and
## answers with the zero vector — a room that looks empty rather than a room that is not
## ready. Everything below checks this first, so that window never produces a query.
func get_map_iteration_id() -> int:
	if not is_inside_tree():
		return 0
	var map := get_navigation_map()
	if not map.is_valid():
		return 0
	if not NavigationServer3D.has_method("map_get_iteration_id"):
		return 0
	return NavigationServer3D.map_get_iteration_id(map)


## The vertices this mesh offers the map as evidence, in world space, spread across the
## whole mesh rather than taken from one corner.
func _probe_points() -> PackedVector3Array:
	var probes := PackedVector3Array()
	var mesh := navigation_mesh
	if mesh == null:
		return probes
	var vertices := mesh.get_vertices()
	if vertices.is_empty():
		return probes
	var step := maxi(1, vertices.size() / SYNC_PROBES)
	var index := 0
	while index < vertices.size() and probes.size() < SYNC_PROBES:
		probes.append(global_transform * vertices[index])
		index += step
	if probes.is_empty():
		probes.append(global_transform * vertices[0])
	return probes


## How many probe points the map answers for, and the worst distance it answered with.
##
## `map_knows_geometry()` used to ask about one vertex and accept anything within a metre.
## That is not a reliable question in this world: the locations are greybox rooms laid out
## around their own origins, so the room that was just freed can cover a corner of the room
## that replaced it, and the map answers "yes" about a floor that is not there. Six spread
## vertices are answered only by the mesh they belong to.
func _probe_map(worst: Array) -> int:
	var probes := _probe_points()
	if probes.is_empty():
		return 0
	var map := get_navigation_map()
	if not map.is_valid():
		return 0
	var answered := 0
	var worst_distance := 0.0
	for probe: Vector3 in probes:
		var closest := NavigationServer3D.map_get_closest_point(map, probe)
		var distance := closest.distance_to(probe)
		worst_distance = maxf(worst_distance, distance)
		if distance <= SYNC_PROBE_TOLERANCE:
			answered += 1
	worst.append(worst_distance)
	return answered


## True when the map is answering from *this* region's mesh: every spread probe is answered
## by a point on it.
func map_knows_geometry() -> bool:
	if not _baked or get_map_iteration_id() <= 0:
		return false
	var worst: Array = []
	var probes := _probe_points().size()
	if probes == 0:
		return false
	return _probe_map(worst) == probes


## The one readiness question every caller should ask before a query: the mesh is baked,
## the map has been synchronized at least once, this region is registered on it, and the
## map answers from this region's geometry. `is_routable()` cannot stand in for this — it
## asks the map whether a route exists somewhere, and the map is happy to answer about the
## room that was just freed.
func is_synchronized() -> bool:
	if not _baked or not is_inside_tree():
		return false
	var map := get_navigation_map()
	if not map.is_valid():
		return false
	_iteration_last_seen = get_map_iteration_id()
	if _iteration_last_seen <= 0:
		return false
	var region := get_rid()
	if not region.is_valid():
		return false
	if not NavigationServer3D.map_get_regions(map).has(region):
		return false
	return map_knows_geometry()


## Awaits `is_synchronized()`, up to `max_frames` physics frames, and reports whether it
## became true. This is a condition wait, not a fixed delay: the frame it returns on is the
## first frame the map answers for this room, whether that is frame 1 or frame 11.
func wait_until_synchronized(max_frames: int = SYNC_CHECK_FRAMES * 4) -> bool:
	if is_synchronized():
		return true
	if not is_inside_tree():
		return false
	for _frame in max_frames:
		await get_tree().physics_frame
		if is_synchronized():
			return true
	return false


## Hands the mesh over again until the map answers for it, then says so loudly.
##
## Re-handing is not a retry of a query: it is the region telling the server "this is the
## mesh" a second time, which is what drops a map entry the server has already cached. It
## runs on the frames after a bake, never every frame, and the budget is a fixed number of
## frames rather than a wall-clock delay.
func _watch_synchronization() -> void:
	if not is_inside_tree() or not _baked:
		return
	if is_synchronized():
		return
	if _sync_checks_left <= 0:
		var worst: Array = []
		_probe_map(worst)
		_sync_error = (
			"the navigation map never answered for the baked mesh (%d faces, %d polygons, "
			% [_source_face_count, _polygon_count]
			+ "map iteration %d, %d region(s), worst probe %.2f m; %s)"
			% [
				_iteration_last_seen, get_map_region_count(),
				worst[0] if not worst.is_empty() else -1.0, describe_sync(),
			]
		)
		push_warning("LocationNavigation: %s" % _sync_error)
		return
	_sync_checks_left -= 1
	var mesh := navigation_mesh
	navigation_mesh = null
	navigation_mesh = mesh
	NavigationServer3D.map_force_update(get_navigation_map())
	await get_tree().physics_frame
	_watch_synchronization()


## Everything a failure report needs about the map, in one place: which room, which map,
## how far the server got, how much geometry it was given, and where that geometry is.
func describe_sync() -> String:
	# Read the map's own id rather than the cached one: a failure report is written about
	# the state at the moment it failed, not the last moment something was checked.
	_iteration_last_seen = get_map_iteration_id()
	_iteration_at_handover = _iteration_at_handover
	var mesh := navigation_mesh
	var vertices := 0
	var bounds := "none"
	if mesh != null:
		var points: PackedVector3Array = mesh.get_vertices()
		vertices = points.size()
		if vertices > 0:
			var box := AABB(points[0], Vector3.ZERO)
			for point: Vector3 in points:
				box = box.expand(point)
			bounds = "%s..%s" % [str(box.position), str(box.end)]
	var probes: Array = []
	var answered := 0
	if get_map_iteration_id() > 0:
		answered = _probe_map(probes)
	return (
		"location=%s map=%s iteration=%d (handover %d) regions=%d polygons=%d vertices=%d "
		% [
			_location_id(), str(get_navigation_map()), _iteration_last_seen,
			_iteration_at_handover, get_map_region_count(), _polygon_count, vertices,
		]
		+ "probes=%d/%d worst=%.2f m first_vertex=%s sync_error=%s"
		% [
			answered, _probe_points().size(),
			probes[0] if not probes.is_empty() else -1.0, bounds,
			"<none>" if _sync_error.is_empty() else _sync_error,
		]
	)


func _location_id() -> String:
	var root := get_parent() as LocationRoot
	if root == null:
		return "<no LocationRoot>"
	return String(root.location_id)


## How long the last bake took, and how much of that was collecting geometry. Zero until a
## bake has run. Debug builds and tests print the same numbers; release builds stay quiet.
func get_bake_usec() -> int:
	return _bake_usec


func get_collect_usec() -> int:
	return _collect_usec


## One line per bake for the console, only in debug builds: what was baked, how long it took,
## how much geometry went in, how many polygons came out, and how many regions the map
## actually registered. A location that takes a second to bake is a location that will hitch
## on the door.
func _report(location_name: String) -> void:
	if not OS.is_debug_build():
		return
	if not _baked:
		print(
			"LocationNavigation: '%s' FAILED to bake in %.1f ms (%d faces parsed): %s"
			% [location_name, _bake_usec / 1000.0, _source_face_count, _bake_error]
		)
		return
	print(
		"LocationNavigation: '%s' baked in %.1f ms (collect %.1f), %d faces -> %d polygons, %d region(s)."
		% [
			location_name,
			_bake_usec / 1000.0,
			_collect_usec / 1000.0,
			_source_face_count,
			_polygon_count,
			_map_region_count,
		]
	)


## How many triangles went into the bake. A room with desks reports far more than a
## room with only a floor and four walls, which is the quickest way to see that the
## furniture was left out of the geometry.
func get_geometry_face_count() -> int:
	return _source_face_count


func is_baked() -> bool:
	return _baked


func get_polygon_count() -> int:
	return _polygon_count


func get_bake_error() -> String:
	return _bake_error


## True when the navigation map can answer a route from this region, i.e. the baked
## polygons really reached the server. A region can exist on the map while its
## polygons are still queued, and a query in that window answers with nothing, which
## looks exactly like a room with no floor.
##
## The map is not asked anything before its first synchronization: that query is refused
## by the server with "made before first map synchronization", prints an error, and answers
## with the zero vector. A room that is not ready is reported as not routable, which is the
## truth, without writing an error into the log on every frame of every load.
func is_routable() -> bool:
	if not _baked:
		return false
	var map := get_navigation_map()
	if not map.is_valid():
		return false
	if get_map_iteration_id() <= 0:
		return false
	var from := NavigationServer3D.map_get_closest_point(map, global_position)
	var to := NavigationServer3D.map_get_closest_point(map, from + Vector3(0.1, 0.0, 0.1))
	if Vector3.ZERO.is_equal_approx(from) and not global_position.is_equal_approx(Vector3.ZERO):
		# An empty map answers the zero vector for every query.
		return false
	return NavigationServer3D.map_get_path(map, from, to, false).size() >= 2


## How many regions the navigation map holds. One means this location's mesh reached
## the map; zero means every path query will come back empty however good the mesh is.
func get_map_region_count() -> int:
	var map := get_navigation_map()
	if not map.is_valid():
		return 0
	return NavigationServer3D.map_get_regions(map).size()


## The map's answer for a world point, or a refusal that says why there is none.
##
## Every query against a navigation map goes through here so that the three states a caller
## can be in are named instead of guessed: the room is not synchronized yet, the point is
## off the mesh, or the point projects onto it. A caller that gets `ok = false` has not been
## handed a plausible-looking point from the room that was just freed, and no error was
## written to the log while the server was still starting up.
##
## `{"ok": bool, "point": Vector3, "offset": float, "reason": String}`
func project_point(point: Vector3) -> Dictionary:
	if not _baked:
		return {"ok": false, "point": point, "offset": 0.0, "reason": "not baked"}
	if get_map_iteration_id() <= 0:
		return {
			"ok": false, "point": point, "offset": 0.0,
			"reason": "the navigation map has not synchronized yet",
		}
	if not is_synchronized():
		return {
			"ok": false, "point": point, "offset": 0.0,
			"reason": "the navigation map is not answering for this room (%s)" % describe_sync(),
		}
	var closest := NavigationServer3D.map_get_closest_point(get_navigation_map(), point)
	var offset := Vector2(closest.x - point.x, closest.z - point.z).length()
	return {"ok": true, "point": closest, "offset": offset, "reason": ""}


## Collects the solid geometry to bake from: every `StaticBody3D` under the location
## root, at any depth, whose layer is included in `geometry_collision_mask`.
##
## The engine's own source-geometry parser is not used here. Nested and instanced
## bodies are exactly what a greybox room is made of (a desk prop is a `StaticBody3D`
## three nodes down), and a body that is silently left out bakes a floor plate that
## the character's path runs straight through — the room looks navigable and the body
## grinds against furniture it was never told about.
func _collect_geometry(root: Node, data: NavigationMeshSourceGeometryData3D) -> int:
	var triangles := 0
	for child in root.get_children():
		var body := child as StaticBody3D
		if body != null and (body.collision_layer & geometry_collision_mask) != 0:
			for owner_id in body.get_shape_owners():
				var local := body.shape_owner_get_transform(owner_id)
				var shape_count := body.shape_owner_get_shape_count(owner_id)
				for index in shape_count:
					var shape := body.shape_owner_get_shape(owner_id, index)
					if shape == null:
						continue
					triangles += _add_shape(data, shape, body.global_transform * local)
		triangles += _collect_geometry(child, data)
	return triangles


## Adds one collision shape. Boxes are the whole vocabulary of this greybox world and
## are written out exactly; anything else falls back to its debug mesh.
func _add_shape(data: NavigationMeshSourceGeometryData3D, shape: Shape3D, xform: Transform3D) -> int:
	var box := shape as BoxShape3D
	if box != null:
		var half := box.size * 0.5
		var corners := PackedVector3Array([
			Vector3(-half.x, -half.y, -half.z), Vector3(half.x, -half.y, -half.z),
			Vector3(half.x, -half.y, half.z), Vector3(-half.x, -half.y, half.z),
			Vector3(-half.x, half.y, -half.z), Vector3(half.x, half.y, -half.z),
			Vector3(half.x, half.y, half.z), Vector3(-half.x, half.y, half.z),
		])
		var quads := [
			[0, 1, 2, 3], [7, 6, 5, 4], [4, 5, 1, 0],
			[5, 6, 2, 1], [6, 7, 3, 2], [7, 4, 0, 3],
		]
		var faces := PackedVector3Array()
		for quad: Array in quads:
			faces.append(corners[quad[0]])
			faces.append(corners[quad[1]])
			faces.append(corners[quad[2]])
			faces.append(corners[quad[0]])
			faces.append(corners[quad[2]])
			faces.append(corners[quad[3]])
		data.add_faces(faces, xform)
		return faces.size() / 3
	var mesh := shape.get_debug_mesh()
	if mesh == null:
		return 0
	data.add_mesh(mesh, xform)
	return mesh.get_faces().size() / 3


func _configure(mesh: NavigationMesh) -> void:
	mesh.geometry_parsed_geometry_type = NavigationMesh.PARSED_GEOMETRY_STATIC_COLLIDERS
	mesh.geometry_collision_mask = geometry_collision_mask
	mesh.agent_radius = agent_radius
	mesh.agent_height = agent_height
	mesh.agent_max_climb = agent_max_climb
	mesh.agent_max_slope = agent_max_slope
	# A navigation map refuses a region whose mesh uses different cell dimensions, and
	# a refused region looks exactly like a room with no floor. The map's values are
	# copied onto the mesh, and the map is asked to use the mesh's values as well, so
	# the two agree whichever side the engine takes as authoritative.
	var map := get_navigation_map()
	if not map.is_valid():
		return
	if NavigationServer3D.has_method("map_set_cell_size") and mesh.cell_size > 0.0:
		NavigationServer3D.map_set_cell_size(map, mesh.cell_size)
	if NavigationServer3D.has_method("map_set_cell_height") and mesh.cell_height > 0.0:
		NavigationServer3D.map_set_cell_height(map, mesh.cell_height)
	if NavigationServer3D.has_method("map_get_cell_size"):
		var map_cell_size: float = NavigationServer3D.map_get_cell_size(map)
		if map_cell_size > 0.0:
			mesh.cell_size = map_cell_size
	if NavigationServer3D.has_method("map_get_cell_height"):
		var map_cell_height: float = NavigationServer3D.map_get_cell_height(map)
		if map_cell_height > 0.0:
			mesh.cell_height = map_cell_height
