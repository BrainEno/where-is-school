; Engine configuration file.
; where-is-school — Godot 4.7.2 Stable, standard GDScript build.
config_version=5

[application]

config/name="where-is-school"
run/main_scene="res://scenes/ui/title_screen.tscn"

[autoload]

GameState="*res://scripts/autoload/game_state.gd"
NarrativeState="*res://scripts/autoload/narrative_state.gd"
Save="*res://scripts/autoload/save_manager.gd"
Loc="*res://scripts/i18n/loc.gd"
CueAudio="*res://scripts/audio/cue_audio.gd"
# One background-music player for the whole session: it has to outlive a scene change,
# and two rooms must never own a copy of it.
Music="*res://scripts/autoload/music_player.gd"
# The player's preferences (text, sound, interface scale, controls) and the way in and out
# of a run (title, continue, new game). Both outlive every scene; see docs/adr/0005-saves.md.
Settings="*res://scripts/autoload/settings_manager.gd"
Session="*res://scripts/ui/game_session.gd"

[audio]

# Master plus one `Music` bus, so the music has its own dial (see docs/ARCHITECTURE.md
# §5m). Named explicitly rather than left to the engine default so the file is visible.
buses/default_bus_layout="res://default_bus_layout.tres"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
; The window opens at the design size: the override pair used to open it at 1280x720, a size
; the UI is not designed at. Resizing is allowed, with a floor of 1280x720
; (`scripts/ui/display_mode.gd` sets it and centres the frame at startup).
window/size/resizable=true
window/size/initial_position_type=1

[editor_plugins]

; The narrative editor dock (addons/narrative_editor). Editor only: the plugin is loaded
; when this project is opened in the editor and never by the running game, and the whole
; folder is excluded from the export preset.
enabled=PackedStringArray("res://addons/narrative_editor/plugin.cfg")

[input]

move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey, "physical_keycode": 65), Object(InputEventKey, "physical_keycode": 4194319), Object(InputEventJoypadMotion, "device": -1, "axis": 0, "axis_value": -1.0), Object(InputEventJoypadButton, "device": -1, "button_index": 13, "pressed": true)]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey, "physical_keycode": 68), Object(InputEventKey, "physical_keycode": 4194321), Object(InputEventJoypadMotion, "device": -1, "axis": 0, "axis_value": 1.0), Object(InputEventJoypadButton, "device": -1, "button_index": 14, "pressed": true)]
}
move_forward={
"deadzone": 0.2,
"events": [Object(InputEventKey, "physical_keycode": 87), Object(InputEventKey, "physical_keycode": 4194320), Object(InputEventJoypadMotion, "device": -1, "axis": 1, "axis_value": -1.0), Object(InputEventJoypadButton, "device": -1, "button_index": 11, "pressed": true)]
}
move_back={
"deadzone": 0.2,
"events": [Object(InputEventKey, "physical_keycode": 83), Object(InputEventKey, "physical_keycode": 4194322), Object(InputEventJoypadMotion, "device": -1, "axis": 1, "axis_value": 1.0), Object(InputEventJoypadButton, "device": -1, "button_index": 12, "pressed": true)]
}
interact={
"deadzone": 0.2,
"events": [Object(InputEventKey, "physical_keycode": 69), Object(InputEventJoypadButton, "device": -1, "button_index": 0, "pressed": true)]
}
dialogue_advance={
"deadzone": 0.2,
"events": [Object(InputEventKey, "physical_keycode": 32), Object(InputEventKey, "physical_keycode": 4194309), Object(InputEventMouseButton, "button_index": 1), Object(InputEventJoypadButton, "device": -1, "button_index": 0, "pressed": true)]
}
backlog={
"deadzone": 0.2,
"events": [Object(InputEventKey, "physical_keycode": 4194306), Object(InputEventJoypadButton, "device": -1, "button_index": 3, "pressed": true)]
}
cancel={
"deadzone": 0.2,
"events": [Object(InputEventKey, "physical_keycode": 4194305), Object(InputEventJoypadButton, "device": -1, "button_index": 1, "pressed": true)]
}
toggle_fullscreen={
"deadzone": 0.2,
"events": [Object(InputEventKey, "physical_keycode": 4194342), Object(InputEventJoypadButton, "device": -1, "button_index": 8, "pressed": true)]
}
toggle_language={
"deadzone": 0.2,
"events": [Object(InputEventKey, "physical_keycode": 76), Object(InputEventJoypadButton, "device": -1, "button_index": 4, "pressed": true)]
}
sprint={
"deadzone": 0.2,
"events": [Object(InputEventKey, "physical_keycode": 4194325), Object(InputEventJoypadButton, "device": -1, "button_index": 10, "pressed": true)]
}
pause={
"deadzone": 0.2,
"events": [Object(InputEventKey, "physical_keycode": 4194305), Object(InputEventJoypadButton, "device": -1, "button_index": 6, "pressed": true)]
}

[gui]

theme/custom="res://assets/ui/app_theme.tres"

[physics]

3d/default_gravity=9.8

[rendering]

renderer/rendering_method="forward_plus"
environment/defaults/default_clear_color=Color(0.106, 0.118, 0.118, 1)
