; Engine configuration file.
; where-is-school — Godot 4.7.2 Stable, standard GDScript build.
config_version=5

[application]

config/name="where-is-school"
run/main_scene="res://scenes/main/main.tscn"

[autoload]

GameState="*res://scripts/autoload/game_state.gd"
NarrativeState="*res://scripts/autoload/narrative_state.gd"
Loc="*res://scripts/i18n/loc.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/window_width_override=1280
window/size/window_height_override=720

[input]

move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey, "physical_keycode": 65), Object(InputEventKey, "physical_keycode": 4194319)]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey, "physical_keycode": 68), Object(InputEventKey, "physical_keycode": 4194321)]
}
move_forward={
"deadzone": 0.2,
"events": [Object(InputEventKey, "physical_keycode": 87), Object(InputEventKey, "physical_keycode": 4194320)]
}
move_back={
"deadzone": 0.2,
"events": [Object(InputEventKey, "physical_keycode": 83), Object(InputEventKey, "physical_keycode": 4194322)]
}
interact={
"deadzone": 0.2,
"events": [Object(InputEventKey, "physical_keycode": 69)]
}
dialogue_advance={
"deadzone": 0.2,
"events": [Object(InputEventKey, "physical_keycode": 32), Object(InputEventKey, "physical_keycode": 4194309), Object(InputEventMouseButton, "button_index": 1)]
}
backlog={
"deadzone": 0.2,
"events": [Object(InputEventKey, "physical_keycode": 4194306)]
}
cancel={
"deadzone": 0.2,
"events": [Object(InputEventKey, "physical_keycode": 4194305)]
}
toggle_language={
"deadzone": 0.2,
"events": [Object(InputEventKey, "physical_keycode": 76)]
}

[physics]

3d/default_gravity=9.8

[rendering]

renderer/rendering_method="forward_plus"
environment/defaults/default_clear_color=Color(0.106, 0.118, 0.118, 1)
