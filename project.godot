; Engine configuration file.
; where-is-school — Godot 4.7.2 Stable, standard GDScript build.
config_version=5

[application]

config/name="where-is-school"
config/description="A painterly 2.5D narrative exploration game. Biology class prologue slice."
run/main_scene="res://scenes/main/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

GameState="*res://scripts/autoload/game_state.gd"
NarrativeLedger="*res://scripts/narrative/narrative_ledger.gd"
AudioCues="*res://scripts/audio/audio_cues.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input]

move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey, "physical_keycode": 65), Object(InputEventKey, "physical_keycode": 4194319), Object(InputEventJoypadMotion, "axis": 0, "axis_value": -1.0), Object(InputEventJoypadButton, "button_index": 13)]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey, "physical_keycode": 68), Object(InputEventKey, "physical_keycode": 4194321), Object(InputEventJoypadMotion, "axis": 0, "axis_value": 1.0), Object(InputEventJoypadButton, "button_index": 14)]
}
move_forward={
"deadzone": 0.2,
"events": [Object(InputEventKey, "physical_keycode": 87), Object(InputEventKey, "physical_keycode": 4194320), Object(InputEventJoypadMotion, "axis": 1, "axis_value": -1.0), Object(InputEventJoypadButton, "button_index": 11)]
}
move_back={
"deadzone": 0.2,
"events": [Object(InputEventKey, "physical_keycode": 83), Object(InputEventKey, "physical_keycode": 4194322), Object(InputEventJoypadMotion, "axis": 1, "axis_value": 1.0), Object(InputEventJoypadButton, "button_index": 12)]
}
interact={
"deadzone": 0.2,
"events": [Object(InputEventKey, "physical_keycode": 69), Object(InputEventKey, "physical_keycode": 32), Object(InputEventJoypadButton, "button_index": 0)]
}
backlog={
"deadzone": 0.2,
"events": [Object(InputEventKey, "physical_keycode": 4194306), Object(InputEventJoypadButton, "button_index": 2)]
}
show_controls={
"deadzone": 0.2,
"events": [Object(InputEventKey, "physical_keycode": 4194334)]
}
notebook={
"deadzone": 0.2,
"events": [Object(InputEventKey, "physical_keycode": 78), Object(InputEventJoypadButton, "button_index": 3)]
}
advance={
"deadzone": 0.2,
"events": [Object(InputEventKey, "physical_keycode": 4194309), Object(InputEventJoypadButton, "button_index": 0)]
}
interact_choice_1={
"deadzone": 0.2,
"events": [Object(InputEventKey, "physical_keycode": 49)]
}
interact_choice_2={
"deadzone": 0.2,
"events": [Object(InputEventKey, "physical_keycode": 50)]
}
interact_choice_3={
"deadzone": 0.2,
"events": [Object(InputEventKey, "physical_keycode": 51)]
}
interact_choice_4={
"deadzone": 0.2,
"events": [Object(InputEventKey, "physical_keycode": 52)]
}

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="interactable"
3d_physics/layer_4="npc"

[physics]

3d/default_gravity=9.8

[gui]

theme/custom="res://assets/themes/prologue_theme.tres"

[rendering]

renderer/rendering_method="forward_plus"
environment/defaults/default_clear_color=Color(0.14, 0.16, 0.17, 1)
anti_aliasing/quality/msaa_3d=1
