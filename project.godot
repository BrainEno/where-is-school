; Engine configuration file.
; where-is-school — Godot 4.7.2 Stable, standard GDScript build.
config_version=5

[application]

config/name="where-is-school"
run/main_scene="res://scenes/main/main.tscn"

[autoload]

GameState="*res://scripts/autoload/game_state.gd"
NarrativeState="*res://scripts/autoload/narrative_state.gd"
Save="*res://scripts/autoload/save_manager.gd"
Loc="*res://scripts/i18n/loc.gd"
CueAudio="*res://scripts/audio/cue_audio.gd"
# One background-music player for the whole session: it has to outlive a scene change,
# and two rooms must never own a copy of it.
Music="*res://scripts/autoload/music_player.gd"

[audio]

# Master plus one `Music` bus, so the music has its own dial (see docs/ARCHITECTURE.md
# §5m). Named explicitly rather than left to the engine default so the file is visible.
buses/default_bus_layout="res://default_bus_layout.tres"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
; The window opens at the design size: the override pair used to open it at 1280x720, a size
; the UI is not designed at. Resizing is allowed, with a floor of 1280x720
; (`scripts/ui/display_mode.gd` sets it and centres the frame at startup).
window/size/resizable=true
window/size/initial_position_type=1

[editor_plugins]

; The narrative editor dock (addons/narrative_editor). Editor only: the plugin is loaded
; when this project is opened in the editor and never by the running game, and the whole
; folder is excluded from the export preset.
enabled=PackedStringArray("res://addons/narrative_editor/plugin.cfg")

[input]

move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey, "physical_keycode": 65), Object(InputEventKey, "physical_keycode": 4194319)]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey, "physical_keycode": 68), Object(InputEventKey, "physical_keycode": 4194321)]
}
move_forward={
"deadzone": 0.2,
"events": [Object(InputEventKey, "physical_keycode": 87), Object(InputEventKey, "physical_keycode": 4194320)]
}
move_back={
"deadzone": 0.2,
"events": [Object(InputEventKey, "physical_keycode": 83), Object(InputEventKey, "physical_keycode": 4194322)]
}
interact={
"deadzone": 0.2,
"events": [Object(InputEventKey, "physical_keycode": 69)]
}
dialogue_advance={
"deadzone": 0.2,
"events": [Object(InputEventKey, "physical_keycode": 32), Object(InputEventKey, "physical_keycode": 4194309), Object(InputEventMouseButton, "button_index": 1)]
}
backlog={
"deadzone": 0.2,
"events": [Object(InputEventKey, "physical_keycode": 4194306)]
}
cancel={
"deadzone": 0.2,
"events": [Object(InputEventKey, "physical_keycode": 4194305)]
}
toggle_fullscreen={
"deadzone": 0.2,
"events": [Object(InputEventKey, "physical_keycode": 4194342)]
}
toggle_language={
"deadzone": 0.2,
"events": [Object(InputEventKey, "physical_keycode": 76)]
}

[gui]

theme/custom="res://assets/ui/app_theme.tres"

[physics]

3d/default_gravity=9.8

[rendering]

renderer/rendering_method="forward_plus"
environment/defaults/default_clear_color=Color(0.106, 0.118, 0.118, 1)
