  "conversations": {
    "align_archive": {
      "default_source": "observed",
      "subjective": false,
      "start": "start",
      "nodes": [
        {
          "id": "start",
          "speaker": "protagonist",
          "text": "The slide has very little travel. Try the door and read the two marks on its plate before moving it.",
          "choices": [
            {
              "id": "check",
              "text": "Match the punched copies by their round holes.",
              "next": "bearing",
              "conditions": {
                "all_flags": [
                  "seen:archive_threshold"
                ],
                "not_flags": [
                  "check:align_archive:bearing",
                  "annex.archive.aligned"
                ]
              }
            },
            {
              "id": "manual",
              "text": "Set the slide from the marks on the door.",
              "next": "manual",
              "conditions": {
                "all_flags": [
                  "annex.archive.unclear"
                ],
                "not_flags": [
                  "annex.archive.aligned"
                ]
              }
            },
            {
              "id": "leave",
              "text": "Leave it for now.",
              "next": "leave"
            }
          ]
        },
        {
          "id": "bearing",
          "speaker": "voice_inference",
          "text": "One sheet has shrunk. A hole is still a hole.",
          "check": {
            "ability": "inference",
            "difficulty": 10,
            "kind": "visible",
            "success": "aligned",
            "failure": "unclear"
          }
        },
        {
          "id": "aligned",
          "speaker": "protagonist",
          "text": "The two holes sit on the same pin. The latch draws back.",
          "effects": [
            {
              "type": "set_flag",
              "flag": "annex.archive.aligned",
              "value": true
            }
          ],
          "next": null
        },
        {
          "id": "unclear",
          "speaker": "protagonist",
          "text": "The long edges will not agree. Ignore their ends: hold the round holes over the same pin.",
          "effects": [
            {
              "type": "set_flag",
              "flag": "annex.archive.unclear",
              "value": true
            }
          ],
          "next": null
        },
        {
          "id": "manual",
          "speaker": "protagonist",
          "text": "Look again at the marks. Where should the slide sit?",
          "choices": [
            {
              "id": "correct",
              "text": "Align the round holes",
              "next": "aligned"
            },
            {
              "id": "wrong",
              "text": "Align the ends of the strips",
              "next": "mismatch"
            },
            {
              "id": "leave",
              "text": "Leave it for now.",
              "next": "leave"
            }
          ]
        },
        {
          "id": "mismatch",
          "speaker": "protagonist",
          "text": "The slide springs back. The bolt does not move.",
          "next": null
        },
        {
          "id": "leave",
          "speaker": "protagonist",
          "text": "Leave the slide as it is.",
          "next": null
        }
      ]
    },
