[gd_resource type="Resource" script_class="DialogueConversation" load_steps=6 format=3]

[ext_resource type="Script" path="res://scripts/dialogue/dialogue_conversation.gd" id="1_conversation"]

[ext_resource type="Script" path="res://scripts/dialogue/dialogue_entry.gd" id="2_entry"]

[ext_resource type="Script" path="res://scripts/dialogue/dialogue_choice.gd" id="3_choice"]


[sub_resource type="Resource" id="Entry_c1"]
script = ExtResource("2_entry")
id = &"c1"
speaker_id = &"narrator"
text = "A school clock, the kind that clunks when the minute jumps. It says 8:07. The second hand seems to be thinking about it."
next_id = &"c2"

[sub_resource type="Resource" id="Entry_c2"]
script = ExtResource("2_entry")
id = &"c2"
speaker_id = &"narrator"
text = "Eventually it clunks. Behind you, nobody reacts. That is somehow the loudest part."

[resource]
script = ExtResource("1_conversation")
id = &"clock"
start_id = &"c1"
presentation = "standard"
entries = Array[ExtResource("2_entry")]([SubResource("Entry_c1"), SubResource("Entry_c2")])
