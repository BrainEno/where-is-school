[gd_resource type="DialogueConversation" load_steps=3 format=3]

[sub_resource type="DialogueEntry" id="Entry_n1"]
id = &"n1"
speaker_id = &"narrator"
text = "A name card in a plastic stand. BIOLOGY, printed in stern caps. It has been taped, and re-taped, over something older."
next_id = &"n2"

[sub_resource type="DialogueEntry" id="Entry_n2"]
id = &"n2"
speaker_id = &"inner"
text = "You wait for your memory to offer the name underneath. It declines."

[resource]
id = &"name_card"
start_id = &"n1"
presentation = "standard"
entries = Array[DialogueEntry]([SubResource("Entry_n1"), SubResource("Entry_n2")])
