[gd_resource type="Resource" script_class="DialogueConversation" load_steps=16 format=3]

[ext_resource type="Script" path="res://scripts/dialogue/dialogue_conversation.gd" id="1_conversation"]

[ext_resource type="Script" path="res://scripts/dialogue/dialogue_entry.gd" id="2_entry"]

[ext_resource type="Script" path="res://scripts/dialogue/dialogue_choice.gd" id="3_choice"]


[sub_resource type="Resource" id="Entry_q1"]
script = ExtResource("2_entry")
id = &"q1"
speaker_id = &"q"
text = "Okaaay, you're awake. You do the desk-stare thing — it's final term, wake up."
next_id = &"q2"

[sub_resource type="Resource" id="Entry_q2"]
script = ExtResource("2_entry")
id = &"q2"
speaker_id = &"q"
text = "Biology, right? The exam two weeks back. You handed it in early. Blank-ish, even. Bold strategy."
next_id = &"q3"
set_flag = &"claim.q.exam_blank"
set_value = true

[sub_resource type="Resource" id="Entry_q3"]
script = ExtResource("2_entry")
id = &"q3"
speaker_id = &"q"
text = "Teacher in charge today — supposed to be — B. You remember B. Red pen. Standing answers. Fear."
next_id = &"q4"
set_flag = &"claim.q.b_strict"
set_value = true

[sub_resource type="Resource" id="Choice_q4_0"]
script = ExtResource("3_choice")
text = "I don't remember the exam."
next_id = &"qa1"
set_flag = &"choice.told_q_unsure"
set_value = true

[sub_resource type="Resource" id="Choice_q4_1"]
script = ExtResource("3_choice")
text = "Of course I remember."
next_id = &"qb1"
set_flag = &"choice.pretend_remembered"
set_value = true

[sub_resource type="Resource" id="Choice_q4_2"]
script = ExtResource("3_choice")
text = "Not now, Q."
next_id = &"qc1"
set_flag = &"choice.brushed_q_off"
set_value = true

[sub_resource type="Resource" id="Entry_q4"]
script = ExtResource("2_entry")
id = &"q4"
speaker_id = &"q"
text = "So. Are you going to sit there all period with your mouth open?"
choices = Array[ExtResource("3_choice")]([SubResource("Choice_q4_0"), SubResource("Choice_q4_1"), SubResource("Choice_q4_2")])

[sub_resource type="Resource" id="Entry_qa1"]
script = ExtResource("2_entry")
id = &"qa1"
speaker_id = &"q"
text = "...Huh. Headache? You've been weird since last week. More than usual, I mean."
next_id = &"qb"

[sub_resource type="Resource" id="Entry_qb1"]
script = ExtResource("2_entry")
id = &"qb1"
speaker_id = &"q"
text = "See? Heard it the first time. Good. Keeps things simple for both of us."
next_id = &"qb"

[sub_resource type="Resource" id="Entry_qc1"]
script = ExtResource("2_entry")
id = &"qc1"
speaker_id = &"q"
text = "Right, moody. Keeping it to myself. Mostly."
next_id = &"qb"

[sub_resource type="Resource" id="Entry_qb"]
script = ExtResource("2_entry")
id = &"qb"
speaker_id = &"q"
text = "Anyway — before the titan arrives, check your bag, okay? Unless you want me to remind her where you sit."
next_id = &"qe"
set_flag = &"claim.q.b_expected"
set_value = true

[sub_resource type="Resource" id="Entry_qe"]
script = ExtResource("2_entry")
id = &"qe"
speaker_id = &"q"
text = "Go on. I'll be here, being emotionally supportive and unbearable."
set_flag = &"flow.q_intro_done"
set_value = true

[resource]
script = ExtResource("1_conversation")
id = &"q_intro"
start_id = &"q1"
presentation = "standard"
entries = Array[ExtResource("2_entry")]([SubResource("Entry_q1"), SubResource("Entry_q2"), SubResource("Entry_q3"), SubResource("Entry_q4"), SubResource("Entry_qa1"), SubResource("Entry_qb1"), SubResource("Entry_qc1"), SubResource("Entry_qb"), SubResource("Entry_qe")])
