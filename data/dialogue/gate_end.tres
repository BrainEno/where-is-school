[gd_resource type="Resource" script_class="DialogueConversation" load_steps=7 format=3]

[ext_resource type="Script" path="res://scripts/dialogue/dialogue_conversation.gd" id="1_conversation"]

[ext_resource type="Script" path="res://scripts/dialogue/dialogue_entry.gd" id="2_entry"]

[ext_resource type="Script" path="res://scripts/dialogue/dialogue_choice.gd" id="3_choice"]


[sub_resource type="Resource" id="Entry_g1"]
script = ExtResource("2_entry")
id = &"g1"
speaker_id = &"narrator"
text = "The gate pushes open easier than it should. It groans anyway."
next_id = &"g2"

[sub_resource type="Resource" id="Entry_g2"]
script = ExtResource("2_entry")
id = &"g2"
speaker_id = &"inner"
text = "Fresh air. Street. Somewhere ahead of you is the place you go home. Probably."
next_id = &"g3"
set_flag = &"observed.reached_gate"
set_value = true

[sub_resource type="Resource" id="Entry_g3"]
script = ExtResource("2_entry")
id = &"g3"
speaker_id = &"narrator"
text = "You walk. Behind you the school settles into its bricks. You don't look back at the windows."

[resource]
script = ExtResource("1_conversation")
id = &"gate_end"
start_id = &"g1"
presentation = "standard"
entries = Array[ExtResource("2_entry")]([SubResource("Entry_g1"), SubResource("Entry_g2"), SubResource("Entry_g3")])
