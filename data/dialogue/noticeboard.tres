[gd_resource type="Resource" script_class="DialogueConversation" load_steps=6 format=3]

[ext_resource type="Script" path="res://scripts/dialogue/dialogue_conversation.gd" id="1_conversation"]

[ext_resource type="Script" path="res://scripts/dialogue/dialogue_entry.gd" id="2_entry"]

[ext_resource type="Script" path="res://scripts/dialogue/dialogue_choice.gd" id="3_choice"]


[sub_resource type="Resource" id="Entry_n1"]
script = ExtResource("2_entry")
id = &"n1"
speaker_id = &"narrator"
text = "Club sign-ups curling at the corners. A fire-drill notice from two terms ago. A band flyer crossed out so hard the pen tore the paper."
next_id = &"n2"

[sub_resource type="Resource" id="Entry_n2"]
script = ExtResource("2_entry")
id = &"n2"
speaker_id = &"narrator"
text = "Along the bottom, in a squared-off red hand: LATECOMERS WILL BE MARKED."

[resource]
script = ExtResource("1_conversation")
id = &"noticeboard"
start_id = &"n1"
presentation = "standard"
entries = Array[ExtResource("2_entry")]([SubResource("Entry_n1"), SubResource("Entry_n2")])
