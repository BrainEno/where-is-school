[gd_resource type="Resource" script_class="DialogueConversation" load_steps=6 format=3]

[ext_resource type="Script" path="res://scripts/dialogue/dialogue_conversation.gd" id="1_conversation"]

[ext_resource type="Script" path="res://scripts/dialogue/dialogue_entry.gd" id="2_entry"]

[ext_resource type="Script" path="res://scripts/dialogue/dialogue_choice.gd" id="3_choice"]


[sub_resource type="Resource" id="Entry_k1"]
script = ExtResource("2_entry")
id = &"k1"
speaker_id = &"narrator"
text = "The final-term timetable, chalked in perfect slant. Wednesday: assembly. Period two: BIOLOGY. The exam date underneath: last week."
next_id = &"k2"

[sub_resource type="Resource" id="Entry_k2"]
script = ExtResource("2_entry")
id = &"k2"
speaker_id = &"narrator"
text = "Today's slot is chalked the same way. Nobody has wiped the board. Nobody has decided whether today actually counts."

[resource]
script = ExtResource("1_conversation")
id = &"blackboard"
start_id = &"k1"
presentation = "standard"
entries = Array[ExtResource("2_entry")]([SubResource("Entry_k1"), SubResource("Entry_k2")])
