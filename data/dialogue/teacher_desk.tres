[gd_resource type="Resource" script_class="DialogueConversation" load_steps=6 format=3]

[ext_resource type="Script" path="res://scripts/dialogue/dialogue_conversation.gd" id="1_conversation"]

[ext_resource type="Script" path="res://scripts/dialogue/dialogue_entry.gd" id="2_entry"]

[ext_resource type="Script" path="res://scripts/dialogue/dialogue_choice.gd" id="3_choice"]


[sub_resource type="Resource" id="Entry_t1"]
script = ExtResource("2_entry")
id = &"t1"
speaker_id = &"narrator"
text = "Face-down quizzes. An ink stain in the exact shape of panic. A drawer that won't quite close."
next_id = &"t2"

[sub_resource type="Resource" id="Entry_t2"]
script = ExtResource("2_entry")
id = &"t2"
speaker_id = &"narrator"
text = "The chair behind the desk is pushed in with parade-ground precision. Students don't sit there. Nobody decides to. Nobody has to."

[resource]
script = ExtResource("1_conversation")
id = &"teacher_desk"
start_id = &"t1"
presentation = "standard"
entries = Array[ExtResource("2_entry")]([SubResource("Entry_t1"), SubResource("Entry_t2")])
