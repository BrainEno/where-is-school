[gd_resource type="Resource" script_class="DialogueConversation" load_steps=7 format=3]

[ext_resource type="Script" path="res://scripts/dialogue/dialogue_conversation.gd" id="1_conversation"]

[ext_resource type="Script" path="res://scripts/dialogue/dialogue_entry.gd" id="2_entry"]

[ext_resource type="Script" path="res://scripts/dialogue/dialogue_choice.gd" id="3_choice"]


[sub_resource type="Resource" id="Entry_s1"]
script = ExtResource("2_entry")
id = &"s1"
speaker_id = &"narrator"
text = "A wooden set square on the teacher's desk. Big enough to rule a border on an essay. One corner has gone round with wear. One edge is chipped."
next_id = &"s2"

[sub_resource type="Resource" id="Entry_s2"]
script = ExtResource("2_entry")
id = &"s2"
speaker_id = &"narrator"
text = "It sits where a hand would fall naturally, between the stack of quizzes and the edge of the desk. Deliberately in reach."
next_id = &"s3"

[sub_resource type="Resource" id="Entry_s3"]
script = ExtResource("2_entry")
id = &"s3"
speaker_id = &"inner"
text = "You know this shape. You can't say how. Your hand closes slowly around nothing."
set_flag = &"recollection.set_square"
set_value = true

[resource]
script = ExtResource("1_conversation")
id = &"set_square"
start_id = &"s1"
presentation = "standard"
entries = Array[ExtResource("2_entry")]([SubResource("Entry_s1"), SubResource("Entry_s2"), SubResource("Entry_s3")])
