[gd_resource type="Resource" script_class="DialogueConversation" load_steps=6 format=3]

[ext_resource type="Script" path="res://scripts/dialogue/dialogue_conversation.gd" id="1_conversation"]

[ext_resource type="Script" path="res://scripts/dialogue/dialogue_entry.gd" id="2_entry"]

[ext_resource type="Script" path="res://scripts/dialogue/dialogue_choice.gd" id="3_choice"]


[sub_resource type="Resource" id="Entry_g1"]
script = ExtResource("2_entry")
id = &"g1"
speaker_id = &"narrator"
text = "The bell comes down the corridor and through the walls. Somewhere, a chair squeaks. Nobody stands up."
next_id = &"g2"

[sub_resource type="Resource" id="Entry_g2"]
script = ExtResource("2_entry")
id = &"g2"
speaker_id = &"narrator"
text = "The door stays shut. Nobody comes in. Somehow the whole room knows it before anyone says so."

[resource]
script = ExtResource("1_conversation")
id = &"bell_gap"
start_id = &"g1"
presentation = "standard"
entries = Array[ExtResource("2_entry")]([SubResource("Entry_g1"), SubResource("Entry_g2")])
