[gd_resource type="Resource" script_class="DialogueConversation" load_steps=8 format=3]

[ext_resource type="Script" path="res://scripts/dialogue/dialogue_conversation.gd" id="1_conversation"]

[ext_resource type="Script" path="res://scripts/dialogue/dialogue_entry.gd" id="2_entry"]

[ext_resource type="Script" path="res://scripts/dialogue/dialogue_choice.gd" id="3_choice"]


[sub_resource type="Resource" id="Entry_b1"]
script = ExtResource("2_entry")
id = &"b1"
speaker_id = &"narrator"
text = "Zip teeth protest. Notebook. Three pens, none capped. A gum wrapper older than it should be."
next_id = &"b2"

[sub_resource type="Resource" id="Entry_b2"]
script = ExtResource("2_entry")
id = &"b2"
speaker_id = &"narrator"
text = "The long sleeve at the bottom, the one shaped like a textbook. It's empty."
next_id = &"b3"
set_flag = &"observed.textbook_missing"
set_value = true

[sub_resource type="Resource" id="Entry_b3"]
script = ExtResource("2_entry")
id = &"b3"
speaker_id = &"inner"
text = "You pat the whole bag again anyway. Corners. Side pocket. Pencil case. Nothing."
next_id = &"b4"

[sub_resource type="Resource" id="Entry_b4"]
script = ExtResource("2_entry")
id = &"b4"
speaker_id = &"narrator"
text = "Under the notebook: a folded cover page from a past exam. The answers section is blank, and the fold is worn soft, like it's been opened many times."
set_flag = &"recollection.exam_paper_blank"
set_value = true

[resource]
script = ExtResource("1_conversation")
id = &"bag_search"
start_id = &"b1"
presentation = "standard"
entries = Array[ExtResource("2_entry")]([SubResource("Entry_b1"), SubResource("Entry_b2"), SubResource("Entry_b3"), SubResource("Entry_b4")])
