[gd_resource type="Resource" script_class="DialogueConversation" load_steps=13 format=3]

[ext_resource type="Script" path="res://scripts/dialogue/dialogue_conversation.gd" id="1_conversation"]

[ext_resource type="Script" path="res://scripts/dialogue/dialogue_entry.gd" id="2_entry"]

[ext_resource type="Script" path="res://scripts/dialogue/dialogue_choice.gd" id="3_choice"]


[sub_resource type="Resource" id="Entry_ft_start"]
script = ExtResource("2_entry")
id = &"ft_start"
speaker_id = &"q"
text = "Back again? Fire away."
next_id = &"ft_choice"

[sub_resource type="Resource" id="Entry_ft_start_pretend"]
script = ExtResource("2_entry")
id = &"ft_start_pretend"
speaker_id = &"q"
text = "Look at you, memory already jogging. Go on."
next_id = &"ft_choice"

[sub_resource type="Resource" id="Choice_ft_choice_0"]
script = ExtResource("3_choice")
text = "Tell me about B."
next_id = &"ft_b"

[sub_resource type="Resource" id="Choice_ft_choice_1"]
script = ExtResource("3_choice")
text = "What if B walks in right now?"
next_id = &"ft_imagine_hint"
condition_flag = &"observed.textbook_missing"
condition_equals = true
set_flag = &"flow.want_imagination"
set_value = true

[sub_resource type="Resource" id="Choice_ft_choice_2"]
script = ExtResource("3_choice")
text = "Nothing. Forget it."
next_id = &"ft_bye"

[sub_resource type="Resource" id="Entry_ft_choice"]
script = ExtResource("2_entry")
id = &"ft_choice"
speaker_id = &"q"
text = "So what is it?"
choices = Array[ExtResource("3_choice")]([SubResource("Choice_ft_choice_0"), SubResource("Choice_ft_choice_1"), SubResource("Choice_ft_choice_2")])

[sub_resource type="Resource" id="Entry_ft_b"]
script = ExtResource("2_entry")
id = &"ft_b"
speaker_id = &"q"
text = "B? Everything has a procedure. Quizzes returned with red in the margins, always. Stand when you answer. Ask before your seat. That's B."
next_id = &"ft_choice"
set_flag = &"claim.q.b_strict"
set_value = true

[sub_resource type="Resource" id="Entry_ft_imagine_hint"]
script = ExtResource("2_entry")
id = &"ft_imagine_hint"
speaker_id = &"q"
text = "Then I'd trade seats with you. Seriously. It's the least I can do."
next_id = &"ft_choice"

[sub_resource type="Resource" id="Entry_ft_bye"]
script = ExtResource("2_entry")
id = &"ft_bye"
speaker_id = &"q"
text = "Heh. Yeah. I'll be here."

[resource]
script = ExtResource("1_conversation")
id = &"q_free_talk"
start_id = &"ft_start"
presentation = "standard"
entries = Array[ExtResource("2_entry")]([SubResource("Entry_ft_start"), SubResource("Entry_ft_start_pretend"), SubResource("Entry_ft_choice"), SubResource("Entry_ft_b"), SubResource("Entry_ft_imagine_hint"), SubResource("Entry_ft_bye")])
