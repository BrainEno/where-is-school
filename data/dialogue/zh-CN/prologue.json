    "expected_b": {
      "default_source": "imagined",
      "subjective": true,
      "start": "b_e_1",
      "nodes": [
        {
          "id": "b_e_1",
          "speaker": "b",
          "text": "站起来。"
        },
        {
          "id": "b_e_2",
          "speaker": "b",
          "text": "我说，站起来。"
        },
        {
          "id": "b_e_3",
