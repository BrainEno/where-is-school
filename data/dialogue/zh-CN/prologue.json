    "n_class": {
      "default_source": "reported",
      "subjective": false,
      "start": "n_1",
      "nodes": [
        {
          "id": "n_1",
          "speaker": "n",
          "text": "早上好。呃……大家都到了吗？",
          "next": "n_2"
        },
        {
          "id": "n_2",
