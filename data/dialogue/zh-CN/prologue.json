              "id": "never",
              "text": "（算了。）",
              "next": "p_never"
            }
          ]
        },
        {
          "id": "p_told",
          "speaker": "protagonist",
          "text": "课本不见了。",
          "source": "observed",
          "next": "q_told_1",
          "effects": [
            {
              "type": "set_flag",
              "flag": "told_q_about_textbook",
              "value": true
            }
