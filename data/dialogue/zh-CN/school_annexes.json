  "conversations": {
    "align_archive": {
      "default_source": "observed",
      "subjective": false,
      "start": "start",
      "nodes": [
        {
          "id": "start",
          "speaker": "protagonist",
          "text": "校准片只有一点行程。试过门、看清门牌上的两道痕，再拨它。",
          "choices": [
            {
              "id": "check",
              "text": "用圆孔找准两张纸的位置。",
              "next": "bearing",
              "conditions": {
                "all_flags": [
                  "seen:archive_threshold"
                ],
                "not_flags": [
                  "check:align_archive:bearing",
                  "annex.archive.aligned"
                ]
              }
            },
            {
              "id": "manual",
              "text": "按门上的线索手动校准。",
              "next": "manual",
              "conditions": {
                "all_flags": [
                  "annex.archive.unclear"
                ],
                "not_flags": [
                  "annex.archive.aligned"
                ]
              }
            },
            {
              "id": "leave",
              "text": "先放下。",
              "next": "leave"
            }
          ]
        },
        {
          "id": "bearing",
          "speaker": "voice_orientation",
          "text": "纸会缩，圆孔还是圆孔。",
          "check": {
            "ability": "orientation",
            "difficulty": 10,
            "kind": "visible",
            "success": "aligned",
            "failure": "unclear"
          }
        },
        {
          "id": "aligned",
          "speaker": "protagonist",
          "text": "两个孔套在同一根销上。门闩缩了回去。",
          "effects": [
            {
              "type": "set_flag",
              "flag": "annex.archive.aligned",
              "value": true
            }
          ],
          "next": null
        },
        {
          "id": "unclear",
          "speaker": "protagonist",
          "text": "长边怎么都对不上。别看纸条两头，把两个圆孔套在同一根销上。",
          "effects": [
            {
              "type": "set_flag",
              "flag": "annex.archive.unclear",
              "value": true
            }
          ],
          "next": null
        },
        {
          "id": "manual",
          "speaker": "protagonist",
          "text": "再看一眼痕迹。从哪里对齐？",
          "choices": [
            {
              "id": "correct",
              "text": "对齐圆孔",
              "next": "aligned"
            },
            {
              "id": "wrong",
              "text": "对齐纸条两头",
              "next": "mismatch"
            },
            {
              "id": "leave",
              "text": "先放下。",
              "next": "leave"
            }
          ]
        },
        {
          "id": "mismatch",
          "speaker": "protagonist",
          "text": "铜片弹回原位。门闩没有动。",
          "next": null
        },
        {
          "id": "leave",
          "speaker": "protagonist",
          "text": "先不动这块校准片。",
          "next": null
        }
      ]
    },
