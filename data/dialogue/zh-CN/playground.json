          ]
        },
        {
          "id": "notice_r_yes",
          "speaker": "resonance",
          "text": "有一笔停过又接上。也许换了人写，也许只是写字的人中途停了一下。你记不起是哪种。",
          "next": null,
          "effects": [
            {
              "type": "record",
              "entry_id": "thought_notice_r_yes",
              "source": "imagined",
              "speaker": "resonance",
              "text": "有一笔停过又接上。也许换了人写，也许只是写字的人中途停了一下。你记不起是哪种。"
            }
          ]
        },
        {
          "id": "notice_r_no",
          "speaker": "resonance",
          "text": "有一瞬间，你觉得那像自己的字。感觉很鲜明，但不能说明是谁写的。",
          "next": null,
          "effects": [
            {
              "type": "record",
              "entry_id": "thought_notice_r_no",
              "source": "imagined",
              "speaker": "resonance",
              "text": "有一瞬间，你觉得那像自己的字。感觉很鲜明，但不能说明是谁写的。"
            }
          ]
        },
        {
          "id": "notice_g_yes",
          "speaker": "guard",
          "text": "折起的角没有挡住时间。也许有人希望下一个人不用展开就能看到。",
          "next": null,
          "effects": [
            {
              "type": "record",
              "entry_id": "thought_notice_g_yes",
              "source": "imagined",
              "speaker": "guard",
              "text": "折起的角没有挡住时间。也许有人希望下一个人不用展开就能看到。"
            }
          ]
        },
        {
          "id": "notice_g_no",
          "speaker": "guard",
          "text": "你想象折角下面有条警告。背面也许是空白的，没有必要先替它编出一场紧急情况。",
          "next": null,
          "effects": [
            {
              "type": "record",
              "entry_id": "thought_notice_g_no",
              "source": "imagined",
              "speaker": "guard",
              "text": "你想象折角下面有条警告。背面也许是空白的，没有必要先替它编出一场紧急情况。"
            }
          ]
        },
        {
          "id": "notice_leave",
          "speaker": "protagonist",
          "text": "你移开视线，告示仍在那里。",
          "next": null
        }
      ]
