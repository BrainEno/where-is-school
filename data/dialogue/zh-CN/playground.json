    "playground_bench": {
      "default_source": "imagined",
      "subjective": true,
      "start": "bench_hub",
      "nodes": [
        {
          "id": "bench_hub",
          "speaker": "protagonist",
          "text": "长椅朝着跑道，一只椅脚落在漆线外。你想从哪里想起？",
          "choices": [
            {
              "id": "pattern",
              "text": "顺着漆线看看。",
              "once": true,
              "check": {
                "id": "bench_pattern",
                "ability": "pattern",
                "difficulty": 6,
                "success": "bench_p_yes",
                "failure": "bench_p_no"
              }
            },
            {
              "id": "guard",
              "text": "看看这里能不能歇脚。",
              "once": true,
              "check": {
                "id": "bench_guard",
                "ability": "guard",
                "difficulty": 6,
                "success": "bench_g_yes",
                "failure": "bench_g_no"
              }
            },
            {
              "id": "leave",
              "text": "暂时不想了。",
              "next": "bench_leave"
            }
          ]
        },
        {
          "id": "bench_p_yes",
          "speaker": "pattern",
          "text": "一条漆线停在椅脚旁。也许画线的人绕开了一张早已在这里的长椅；这只是猜测。",
          "next": null,
          "effects": [
            {
              "type": "record",
              "entry_id": "thought_bench_p_yes",
              "source": "imagined",
              "speaker": "pattern",
              "text": "一条漆线停在椅脚旁。也许画线的人绕开了一张早已在这里的长椅；这只是猜测。"
            }
          ]
        },
        {
          "id": "bench_p_no",
          "speaker": "pattern",
          "text": "你觉得四条线一定代表四个座位。接着发现椅旁的线是断开的，也许这个规律来得太急了。",
          "next": null,
          "effects": [
            {
              "type": "record",
              "entry_id": "thought_bench_p_no",
              "source": "imagined",
              "speaker": "pattern",
              "text": "你觉得四条线一定代表四个座位。接着发现椅旁的线是断开的，也许这个规律来得太急了。"
            }
          ]
        },
        {
          "id": "bench_g_yes",
          "speaker": "guard",
          "text": "椅脚看着像压在漆上，也许长椅是后来放的。不管怎样，固定件看起来足够稳，可以歇一歇。",
          "next": null,
          "effects": [
            {
              "type": "record",
              "entry_id": "thought_bench_g_yes",
              "source": "imagined",
              "speaker": "guard",
              "text": "椅脚看着像压在漆上，也许长椅是后来放的。不管怎样，固定件看起来足够稳，可以歇一歇。"
            }
          ]
        },
        {
          "id": "bench_g_no",
          "speaker": "guard",
          "text": "那片阴影可能是松动的固定件，也可能只是阴影。先留一点余地，以后再看。",
          "next": null,
          "effects": [
            {
              "type": "record",
              "entry_id": "thought_bench_g_no",
              "source": "imagined",
              "speaker": "guard",
              "text": "那片阴影可能是松动的固定件，也可能只是阴影。先留一点余地，以后再看。"
            }
          ]
        },
        {
          "id": "bench_leave",
          "speaker": "protagonist",
          "text": "暂时让长椅只是长椅。",
          "next": null
        }
      ]
    },
    "playground_notice": {
      "default_source": "imagined",
      "subjective": true,
      "start": "notice_hub",
      "nodes": [
        {
          "id": "notice_hub",
          "speaker": "protagonist",
          "text": "告示褪了色，下方的字迹节奏有些不同。你想跟随哪个念头？",
          "choices": [
            {
              "id": "resonance",
              "text": "追着熟悉的感觉想一想。",
              "once": true,
              "check": {
                "id": "notice_resonance",
                "ability": "resonance",
                "difficulty": 6,
                "success": "notice_r_yes",
                "failure": "notice_r_no"
              }
            },
            {
              "id": "guard",
              "text": "看看有没有需要留意的地方。",
              "once": true,
              "check": {
                "id": "notice_guard",
                "ability": "guard",
                "difficulty": 6,
                "success": "notice_g_yes",
