{
  "format_version": 2,
  "locale": "zh-CN",
  "chapter": "inner_voice",
  "conversations": {
    "voice_notice": {
      "default_source": "observed",
      "subjective": false,
      "start": "vn_1",
      "nodes": [
        {
          "id": "vn_1",
          "speaker": "voice_orientation",
          "text": "等一下。这里有一处不太对。",
          "check": {
            "ability": "orientation",
            "difficulty": 8,
            "kind": "hidden",
            "success": "vn_ok",
            "failure": "vn_bad"
          }
        },
        {
          "id": "vn_ok",
          "speaker": "voice_orientation",
          "text": "告示都钉在同一高度，只有一张例外。那张更高，背后胶带的印子还是干净的。有人把它挪高了，好让人读到。",
          "next": null
        },
        {
          "id": "vn_bad",
          "speaker": "voice_orientation",
          "text": "一块板子，上面贴了几张纸。还能有什么？",
          "next": "vn_bad_2"
        },
        {
          "id": "vn_bad_2",
          "speaker": "protagonist",
          "text": "你读了最上面两张：求租一间房，钢琴出售。第三张被翻过去贴住了，但没有被撕下来。",
          "next": null
        }
      ]
    },
    "voice_arrival": {
      "default_source": "observed",
      "subjective": false,
      "start": "va_1",
      "nodes": [
        {
          "id": "va_1",
          "speaker": "voice_orientation",
          "text": "这块操场挺长，窄一些。小路从一个角上通进来。",
          "check": {
            "ability": "orientation",
            "difficulty": 9,
            "kind": "hidden",
            "success": "va_ok",
            "failure": "va_bad"
          }
        },
        {
          "id": "va_ok",
          "speaker": "voice_orientation",
          "text": "水泥地中间有一道接缝，像是分两次浇的。接缝一直通到另一头。可大门偏偏开在短边上。",
          "next": null
        },
        {
          "id": "va_bad",
          "speaker": "voice_orientation",
          "text": "一块操场。两个篮架、一间工具棚、一条长椅。",
          "next": "va_bad_2"
        },
        {
          "id": "va_bad_2",
          "speaker": "protagonist",
          "text": "你以前见过这样的操场。也可能只是学校里的操场都差不多。",
          "next": null
        }
      ]
    },
    "voice_hoop": {
      "default_source": "observed",
      "subjective": false,
      "start": "vh_1",
      "nodes": [
        {
          "id": "vh_1",
          "speaker": "voice_orientation",
          "text": "等一下。看那根篮架的杆子立在哪里。",
          "check": {
            "ability": "orientation",
            "difficulty": 9,
            "kind": "hidden",
            "success": "vh_ok",
            "failure": "vh_bad"
          }
        },
        {
          "id": "vh_ok",
          "speaker": "voice_orientation",
          "text": "杆子周围的水泥比操场其他地方新。墙上还有几个旧螺栓孔，填过，又刷了一遍漆。篮架以前应该在别处。",
          "next": null
        },
        {
          "id": "vh_bad",
          "speaker": "voice_orientation",
          "text": "篮圈的高度看起来没什么问题。",
          "next": "vh_bad_2"
        },
        {
          "id": "vh_bad_2",
          "speaker": "protagonist",
          "text": "你也说不准正常的篮筐该有多高。只是底座那块水泥颜色不一样，篮网看着也比篮圈新。",
          "next": null
        }
      ]
    }
  }
}
