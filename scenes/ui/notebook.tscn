[gd_scene load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/ui/note_book.gd" id="sc_note"]
[ext_resource type="Theme" path="res://resources/ui/prologue_theme.tres" id="theme_note"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_1"]
bg_color = Color(0.09, 0.10, 0.10, 0.97)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.50, 0.49, 0.43, 0.9)
content_margin_left = 28
content_margin_top = 22
content_margin_right = 28
content_margin_bottom = 22

[node name="NoteBook" type="Control"]
script = ExtResource("sc_note")
anchors_preset = 15
anchor_right = "1.0"
anchor_bottom = "1.0"
theme = ExtResource("theme_note")

[node name="Dim" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = "1.0"
anchor_bottom = "1.0"
