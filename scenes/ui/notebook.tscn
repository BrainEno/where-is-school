[node name="Panel" type="PanelContainer" parent="."]
anchors_preset = 15
anchor_right = "1.0"
anchor_bottom = "1.0"
offset_left = "150.0"
offset_top = "70.0"
offset_right = -150.0
offset_bottom = -70.0
theme_override_styles/panel = SubResource("StyleBoxFlat_1")

[node name="VBox" type="VBoxContainer" parent="Panel"]
