[node name="TitleRow" type="HBoxContainer" parent="Panel/VBox"]

[node name="Title" type="Label" parent="Panel/VBox/TitleRow"]
text = "笔记 / Notes"
theme_override_font_sizes/font_size = 26
size_flags_horizontal = 3

[node name="CloseButton" type="Button" parent="Panel/VBox/TitleRow"]
unique_name_in_owner = true
text = "关闭 [N]"

[node name="Hint" type="Label" parent="Panel/VBox"]
text = "这里只记我确定知道来源的事。想像的和听来的分开放。"
theme_override_font_sizes/font_size = 15
theme_override_colors/font_color = Color(0.66, 0.67, 0.64, 1)
autowrap_mode = 3

[node name="EmptyLabel" type="Label" parent="Panel/VBox"]
unique_name_in_owner = true
text = "（还没有记下任何事。） / (Nothing recorded yet.)"
theme_override_colors/font_color = Color(0.62, 0.63, 0.61, 1)

[node name="Scroll" type="ScrollContainer" parent="Panel/VBox"]
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="ContentRoot" type="VBoxContainer" parent="Panel/VBox/Scroll"]
unique_name_in_owner = true
size_flags_horizontal = 3
theme_override_constants/separation = 18

[node name="TabContainer" type="TabContainer" parent="Panel/VBox"]
unique_name_in_owner = true
