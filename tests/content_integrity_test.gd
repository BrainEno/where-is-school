extends SceneTree
## Cross-references the data files against the location scenes.
##
## The dialogue, inspection and ability libraries validate themselves, but nothing
## so far noticed when a scene pointed at an id that does not exist: that failure
## only appears when a player walks up to the prop and nothing happens. This test is
## that link. It reads the generated location scenes as text (they are generated by
## `tools/build_outdoor_locations.py`, so their shape is stable) and asserts:
##
## - every `inspection_id` in a scene exists in every language;
## - every `conversation_route` in a scene matches a routing rule;
## - every prompt key in a scene exists in the locale tables;
## - every exit leads to a scene that exists, at a spawn point that exists;
## - every exit that ends the slice carries a title and a body;
## - the yard really is the last space, and the alley is not a dead end.
##
## It is a static check on purpose: it needs no rendering, so it can run on every
## pull request without adding a playtest to CI.

const Harness = preload("res://tests/test_harness.gd")

const LOCATIONS: Array[String] = ["classroom", "corridor", "street", "residential", "alley", "playground"]
const END_CARD_KEY := "end.slice"

var _failures: Array[String] = []
var _inspections: InspectionLibrary = null
var _library: DialogueLibrary = null
var _scene_text: Dictionary = {}


func _initialize() -> void:
	Harness.arm_watchdog(self, 120.0, "content_integrity_test.gd")
	call_deferred("_run")


func _run() -> void:
	_inspections = InspectionLibrary.load_all()
	if not _inspections.is_valid():
		Harness.finish(self, ["inspections: " + _inspections.describe_errors()], "")
		return
	var abilities := InnerAbilities.load_all()
	_library = DialogueLibrary.load_all(abilities)
	if not _library.is_valid():
		Harness.finish(self, ["dialogue: " + _library.describe_errors()], "")
		return
	L10n.load_tables()

	for locale in L10n.LOCALES:
		_inspections.set_locale(locale)
		_library.set_locale(locale)
		L10n.current = locale
		for location in LOCATIONS:
			_check_location(location, locale)

	_check_chain()
	Harness.finish(self, _failures, "every scene reference resolves in every language.")


# --- per location -----------------------------------------------------------


func _check_location(location: String, locale: String) -> void:
	var text := _read_scene(location)
	if text.is_empty():
		return
	var label := "%s (%s)" % [location, locale]

	for inspection_id in _matches(text, "inspection_id = &\"([^\"]+)\""):
		if _inspections.get_inspection(StringName(inspection_id)) == null:
			_failures.append("%s: inspection '%s' does not exist." % [label, inspection_id])

	for route in _matches(text, "conversation_route = &\"([^\"]+)\""):
		if not ConversationRouter.has_route(StringName(route)):
			_failures.append("%s: conversation route '%s' has no rules." % [label, route])
		elif String(ConversationRouter.select(StringName(route), {})).is_empty():
			_failures.append("%s: route '%s' selects nothing with a fresh save." % [label, route])

	for key in _matches(text, "prompt_key = \"([^\"]+)\""):
		if not L10n.has_key(key):
			_failures.append("%s: prompt key '%s' is missing." % [label, key])

	for exit_block in _exit_blocks(text):
		var scene := String(exit_block.get("destination_scene", ""))
		var spawn := String(exit_block.get("destination_spawn", ""))
		var destination_id := String(exit_block.get("destination_id", ""))
		var end_key := String(exit_block.get("end_card_key", ""))
		if scene.is_empty():
			if end_key.is_empty():
				_failures.append("%s: an exit has neither a destination nor an end card." % label)
			else:
				if not L10n.has_key("%s.title" % end_key):
					_failures.append("%s: end card '%s' has no title." % [label, end_key])
				if not L10n.has_key("%s.body" % end_key):
					_failures.append("%s: end card '%s' has no body." % [label, end_key])
			continue
		if not ResourceLoader.exists(scene):
			_failures.append("%s: exit leads to missing scene '%s'." % [label, scene])
			continue
		var destination_name := scene.get_file().get_basename()
		var destination_text := _read_scene(destination_name)
		if spawn.is_empty():
			_failures.append(
				"%s: exit leads to '%s' without naming a spawn point."
				% [label, destination_name]
			)
		elif (
			not destination_text.is_empty()
			and not (("name=\"%s\"" % spawn) in destination_text)
		):
			_failures.append(
				"%s: exit points at spawn '%s', which '%s' does not have."
				% [label, spawn, destination_name]
			)
		# The exit's claim about *which* place it enters has to match the place itself:
		# CURRENT_LOCATION is written from this id, so a mismatch would put the player
		# in one room and the story flag in another.
		if destination_id.is_empty():
			_failures.append(
				"%s: exit leads to '%s' without declaring a destination_id."
				% [label, destination_name]
			)
		elif not destination_text.is_empty():
			var declared := _matches(destination_text, "location_id = &\"([^\"]+)\"")
			if declared.is_empty():
				_failures.append(
					"%s: exit leads to '%s', which declares no location_id."
					% [label, destination_name]
				)
			elif declared[0] != destination_id:
				_failures.append(
					"%s: exit declares location_id '%s' but '%s' is '%s'."
					% [label, destination_id, destination_name, declared[0]]
				)


## The slice must be walkable from the courtyard to the yard, and the yard must be
## where it stops. This is the check that would have caught leaving the old end card
## behind on the courtyard's alley exit.
func _check_chain() -> void:
	var residential := _read_scene("residential")
	if residential.is_empty():
		return
	if _end_card_exits(residential) > 0:
		_failures.append("The residential courtyard still contains an end-of-slice exit.")
	var alley := _read_scene("alley")
	if _end_card_exits(alley) > 0:
		_failures.append("The alley ends the slice; the slice should end in the open yard.")
	if not ("res://scenes/locations/alley/alley.tscn" in residential):
		_failures.append("The courtyard does not lead to the alley.")
	if not ("res://scenes/locations/playground/playground.tscn" in alley):
		_failures.append("The alley does not lead to the yard.")
	var playground := _read_scene("playground")
	if not (END_CARD_KEY in playground):
		_failures.append("The yard does not carry the slice's end card.")
	if _end_card_exits(playground) != 1:
		_failures.append(
			"The yard should have exactly one end-of-slice exit, found %d."
			% _end_card_exits(playground)
		)
	# The yard is the point of this slice: several anchors, and space that is not a
	# corridor (its own ground much wider than the alley's).
	if _matches(playground, "inspection_id = &\"([^\"]+)\"").size() < 2:
		_failures.append("The yard has almost nothing to inspect.")
	if _matches(playground, "conversation_route = &\"([^\"]+)\"").size() < 2:
		_failures.append("The yard offers no conversations of its own.")


# --- helpers ----------------------------------------------------------------


func _read_scene(location: String) -> String:
	if _scene_text.has(location):
		return _scene_text[location]
	var path := "res://scenes/locations/%s/%s.tscn" % [location, location]
	if not FileAccess.file_exists(path):
		_failures.append("Missing location scene: %s" % path)
		_scene_text[location] = ""
		return ""
	var file := FileAccess.open(path, FileAccess.READ)
	if file == null:
		_failures.append("Could not open %s." % path)
		_scene_text[location] = ""
		return ""
	var text := file.get_as_text()
	file.close()
	_scene_text[location] = text
	return text


func _matches(text: String, pattern: String) -> Array[String]:
	var results: Array[String] = []
	var regex := RegEx.create_from_string(pattern)
	for found in regex.search_all(text):
		results.append(found.get_string(1))
	return results


## Splits the scene into its exit nodes and keeps the properties each one sets.
func _exit_blocks(text: String) -> Array[Dictionary]:
	var blocks: Array[Dictionary] = []
	var current: Dictionary = {}
	for raw_line in text.split("\n"):
		var line := String(raw_line).strip_edges()
		if line.begins_with("[node "):
			if not current.is_empty():
				blocks.append(current)
			current = {}
			# Exit nodes instance the exit scene by generated id ("13_location_exit").
			if "location_exit" in line:
				current = {"end_card_key": ""}
			continue
		if current.is_empty():
			continue
		for prefix: String in [
			"destination_scene = ", "destination_spawn = &", "destination_id = &",
			"is_milestone_end = ", "end_card_key = ",
		]:
			if line.begins_with(prefix):
				var key := prefix.split(" = ")[0]
				var value := line.substr(prefix.length()).trim_prefix("\"").trim_suffix("\"")
				if prefix.ends_with("&"):
					value = value.trim_prefix("\"")
				current[key] = value
	if not current.is_empty():
		blocks.append(current)
	var exits: Array[Dictionary] = []
	for block: Dictionary in blocks:
		if block.has("destination_scene") or block.has("end_card_key"):
			exits.append(block)
	return exits


func _end_card_exits(text: String) -> int:
	var count := 0
	for block: Dictionary in _exit_blocks(text):
		if block.has("end_card_key") and not String(block["end_card_key"]).is_empty():
			count += 1
	return count
