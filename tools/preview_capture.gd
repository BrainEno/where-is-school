extends SceneTree
## Offline preview: projects the shipped classroom geometry through the shipped
## 2.5D camera with a small software rasteriser and writes PNGs.
##
## Why this exists: this repository must be validated on machines without a GPU
## (the authoring sandbox and headless CI have no Vulkan/OpenGL driver). A real
## screenshot is not possible there, and a mocked-up illustration would be
## dishonest evidence. This tool does the next best thing: it reads the actual
## runtime scene graph — every MeshInstance3D transform, mesh arrays and material
## colour — projects the vertices through the actual Camera3D of the player rig,
## and z-buffers them into an image.
##
## What it proves: camera framing, room composition, prop placement, occlusion.
## What it does NOT prove: lighting, shadows, tone mapping, bloom, fog, textures.
## Do not present the output as a render.
##
## Usage:
##   godot --headless --path . --script res://tools/preview_capture.gd
## Output: user://preview/*.png  (copy into docs/captures/ to publish)

const OUT_DIR := "user://preview"
const WIDTH := 960
const HEIGHT := 540
const LIGHT_DIR := Vector3(-0.45, 0.78, 0.42)
const NEAR_PLANE := 0.08

var _colour: Image
var _depth: PackedFloat32Array
var _camera: Camera3D
var _inv_camera: Transform3D
var _camera_pos: Vector3


func _initialize() -> void:
	call_deferred("_run")


func _run() -> void:
	DirAccess.make_dir_recursive_absolute(OUT_DIR)

	var main_scene: PackedScene = load("res://scenes/main/main.tscn")
	var game: Node = main_scene.instantiate()
	# Do not autostart: the wake fade would black out the capture.
	game.set("autostart", false)
	root.add_child(game)
	await process_frame
	await process_frame
	await process_frame

	var player := game.get_node_or_null("Player") as PlayerController
	if player == null:
		push_error("preview_capture: no Player in main scene.")
		quit(1)
		return
	_camera = player.get_camera()
	if _camera == null:
		push_error("preview_capture: player has no camera.")
		quit(1)
		return

	var room := game.get_node_or_null("LocationRoot/Classroom") as Node3D
	if room == null:
		push_error("preview_capture: no classroom loaded.")
		quit(1)
		return

	# Place the player exactly where the prologue puts them when it wakes.
	var seated := room.get_node_or_null("SpawnSeated") as Marker3D
	if seated != null:
		player.teleport_to(seated.global_transform)
	await process_frame
	await process_frame

	_dump_layout(room)
	_project([room, game.get_node_or_null("Player"), room.get_node_or_null("NpcQ"), room.get_node_or_null("NpcN")], "classroom_wake_view.png")
	_plan(room, "classroom_plan.png")

	print("Preview written to %s" % ProjectSettings.globalize_path(OUT_DIR))
	quit(0)


# --- scene inventory --------------------------------------------------------

func _dump_layout(room: Node3D) -> void:
	var data: Dictionary = {
		"note": "Generated by tools/preview_capture.gd from the live scene graph.",
		"camera": {
			"position": [snappedf(_camera.global_position.x, 0.01), snappedf(_camera.global_position.y, 0.01), snappedf(_camera.global_position.z, 0.01)],
			"rotation": [snappedf(_camera.global_rotation_degrees.x, 0.1), snappedf(_camera.global_rotation_degrees.y, 0.1), snappedf(_camera.global_rotation_degrees.z, 0.1)],
			"fov": _camera.fov,
		},
		"interactables": [],
		"props": [],
	}
	for node in room.find_children("*", "Interactable3D", true, false):
		var item := node as Interactable3D
		data["interactables"].append({
			"id": String(item.interact_id),
			"prompt": item.get_prompt_text(),
			"position": [snappedf(item.global_position.x, 0.01), snappedf(item.global_position.y, 0.01), snappedf(item.global_position.z, 0.01)],
			"enabled_at_boot": item.start_enabled,
		})
	for node in room.find_children("*", "MeshInstance3D", true, false):
		var mi := node as MeshInstance3D
		if mi.mesh == null:
			continue
		var centre: Vector3 = mi.global_transform * mi.mesh.get_aabb().get_center()
		data["props"].append({
			"node": String(room.get_path_to(mi)),
			"centre": [snappedf(centre.x, 0.01), snappedf(centre.y, 0.01), snappedf(centre.z, 0.01)],
		})
	var file := FileAccess.open(OUT_DIR.path_join("classroom_layout.json"), FileAccess.WRITE)
	file.store_string(JSON.stringify(data, "  "))
	file.close()
	print("Layout: %d interactables, %d meshes, camera at %s" % [
		data["interactables"].size(), data["props"].size(), str(data["camera"]["position"])
	])


# --- software projection ----------------------------------------------------

func _project(roots: Array, filename: String) -> void:
	_colour = Image.create(WIDTH, HEIGHT, false, Image.FORMAT_RGBA8)
	_colour.fill(Color(0.16, 0.17, 0.16, 1))
	_depth = PackedFloat32Array()
	_depth.resize(WIDTH * HEIGHT)
	_depth.fill(INF)
	_inv_camera = _camera.global_transform.affine_inverse()
	_camera_pos = _camera.global_position

	var triangles := 0
	var drawn := 0
	var mesh_nodes: Array = []
	for root_node in roots:
		if root_node == null:
			continue
		if root_node is MeshInstance3D:
			mesh_nodes.append(root_node)
		mesh_nodes.append_array(root_node.find_children("*", "MeshInstance3D", true, false))
	for node in mesh_nodes:
		var mi := node as MeshInstance3D
		if mi.mesh == null or not mi.is_visible_in_tree():
			continue
		var basis: Transform3D = mi.global_transform
		var colour := _material_colour(mi)
		for surface in mi.mesh.get_surface_count():
			var arrays: Array = mi.mesh.surface_get_arrays(surface)
			var verts: PackedVector3Array = arrays[Mesh.ARRAY_VERTEX]
			if verts.is_empty():
				continue
			var indices: PackedInt32Array = arrays[Mesh.ARRAY_INDEX] if arrays[Mesh.ARRAY_INDEX] != null else PackedInt32Array()
			var count: int = indices.size() if not indices.is_empty() else verts.size()
			var i := 0
			while i + 2 < count:
				var ia: int = indices[i] if not indices.is_empty() else i
				var ib: int = indices[i + 1] if not indices.is_empty() else i + 1
				var ic: int = indices[i + 2] if not indices.is_empty() else i + 2
				i += 3
				triangles += 1
				var va: Vector3 = _inv_camera * (basis * verts[ia])
				var vb: Vector3 = _inv_camera * (basis * verts[ib])
				var vc: Vector3 = _inv_camera * (basis * verts[ic])

				# Back-face cull in view space. The camera looks down -z, so a
				# front-facing triangle has its normal pointing toward +z.
				var normal: Vector3 = (vb - va).cross(vc - va).normalized()
				if normal.z <= 0.0:
					continue

				var shade_normal: Vector3 = normal
				var shaded: Color = _shade(colour, shade_normal)
				for tri in _clip_near([va, vb, vc]):
					if _raster(tri[0], tri[1], tri[2], shaded):
						drawn += 1
	print("Projected %d triangles (%d drawn) for %s" % [triangles, drawn, filename])
	_colour.save_png(OUT_DIR.path_join(filename))


## Clips a view-space triangle against the near plane and returns a fan of
## triangles. Without this, a wall behind the camera projects to wild
## coordinates and paints over the whole image.
func _clip_near(poly: Array) -> Array:
	var result: Array = []
	var count: int = poly.size()
	for index in count:
		var current: Vector3 = poly[index]
		var next: Vector3 = poly[(index + 1) % count]
		var current_in: bool = current.z < -NEAR_PLANE
		var next_in: bool = next.z < -NEAR_PLANE
		if current_in:
			result.append(current)
		if current_in != next_in:
			var t: float = (-NEAR_PLANE - current.z) / (next.z - current.z)
			result.append(current.lerp(next, t))
	var triangles: Array = []
	if result.size() < 3:
		return triangles
	for index in range(1, result.size() - 1):
		triangles.append([result[0], result[index], result[index + 1]])
	return triangles


func _material_colour(mi: MeshInstance3D) -> Color:
	var mat := mi.material_override as StandardMaterial3D
	if mat == null and mi.mesh != null and mi.mesh.get_surface_count() > 0:
		mat = mi.mesh.surface_get_material(0) as StandardMaterial3D
	if mat == null:
		return Color(0.55, 0.55, 0.52)
	if mat.emission_enabled:
		return mat.emission
	var c := mat.albedo_color
	return Color(c.r, c.g, c.b)


func _shade(base: Color, normal: Vector3) -> Color:
	# The room supplies its own practical lighting; this flat shade only exists so
	# surfaces can be told apart, so keep the contrast low.
	var lambert: float = clampf(normal.dot(LIGHT_DIR.normalized()), 0.0, 1.0)
	var level: float = 0.5 + lambert * 0.6
	return Color(base.r * level, base.g * level, base.b * level, 1.0)


func _project_point(view: Vector3) -> Vector2:
	var depth: float = -view.z
	var half_fov: float = deg_to_rad(_camera.fov) * 0.5
	var focal: float = (HEIGHT * 0.5) / tan(half_fov)
	var aspect: float = float(WIDTH) / float(HEIGHT)
	return Vector2(
		WIDTH * 0.5 + (view.x / depth) * focal / aspect,
		HEIGHT * 0.5 - (view.y / depth) * focal
	)


func _raster(a: Vector3, b: Vector3, c: Vector3, colour: Color) -> bool:
	var pa: Vector2 = _project_point(a)
	var pb: Vector2 = _project_point(b)
	var pc: Vector2 = _project_point(c)
	var area: float = (pb.x - pa.x) * (pc.y - pa.y) - (pb.y - pa.y) * (pc.x - pa.x)
	if absf(area) < 0.0001:
		return false

	var min_x: int = maxi(int(floor(minf(pa.x, minf(pb.x, pc.x)))), 0)
	var max_x: int = mini(int(ceil(maxf(pa.x, maxf(pb.x, pc.x)))), WIDTH - 1)
	var min_y: int = maxi(int(floor(minf(pa.y, minf(pb.y, pc.y)))), 0)
	var max_y: int = mini(int(ceil(maxf(pa.y, maxf(pb.y, pc.y)))), HEIGHT - 1)
	if max_x < min_x or max_y < min_y:
		return false

	# 1/w interpolation: perspective-correct depth needs reciprocals.
	var za: float = 1.0 / (-a.z)
	var zb: float = 1.0 / (-b.z)
	var zc: float = 1.0 / (-c.z)
	var inv_area: float = 1.0 / area
	var drew := false
	for y in range(min_y, max_y + 1):
		for x in range(min_x, max_x + 1):
			var px: float = x + 0.5
			var py: float = y + 0.5
			var w0: float = ((pb.x - pa.x) * (py - pa.y) - (pb.y - pa.y) * (px - pa.x)) * inv_area
			var w1: float = ((pc.x - pb.x) * (py - pb.y) - (pc.y - pb.y) * (px - pb.x)) * inv_area
			var w2: float = 1.0 - w0 - w1
			if w0 < -0.0005 or w1 < -0.0005 or w2 < -0.0005:
				continue
			var inv_depth: float = za * w2 + zb * w1 + zc * w0
			if inv_depth <= 0.0:
				continue
			var depth: float = 1.0 / inv_depth
			var index: int = y * WIDTH + x
			if depth >= _depth[index]:
				continue
			_depth[index] = depth
			_colour.set_pixel(x, y, colour)
			drew = true
	return drew


# --- top-down plan ----------------------------------------------------------

func _plan(room: Node3D, filename: String) -> void:
	const SCALE := 54.0
	const PW := 1100
	const PH := 900
	var img := Image.create(PW, PH, false, Image.FORMAT_RGBA8)
	img.fill(Color(0.08, 0.09, 0.09, 1))
	var to_px := func(p: Vector3) -> Vector2:
		return Vector2(PW * 0.5 + p.x * SCALE, PH * 0.5 + p.z * SCALE)

	for node in room.find_children("*", "MeshInstance3D", true, false):
		var mi := node as MeshInstance3D
		if mi.mesh == null:
			continue
		var aabb: AABB = mi.mesh.get_aabb()
		var centre: Vector3 = mi.global_transform * aabb.get_center()
		var size: Vector3 = aabb.size * mi.global_transform.basis.get_scale()
		var colour := Color(0.4, 0.42, 0.4, 0.7)
		if centre.y > 2.3:
			colour = Color(0.32, 0.35, 0.32, 0.3)
		if size.y > 1.2:
			colour = Color(0.52, 0.54, 0.51, 0.85)
		_fill_rect(img, to_px.call(centre - Vector3(size.x * 0.5, 0, size.z * 0.5)),
			to_px.call(centre + Vector3(size.x * 0.5, 0, size.z * 0.5)), colour)

	for node in room.find_children("*", "Interactable3D", true, false):
		var item := node as Interactable3D
		var colour := Color(0.93, 0.74, 0.5) if item.start_enabled else Color(0.5, 0.47, 0.43)
		_ring(img, to_px.call(item.global_position), 8.0, colour)

	for marker_name in ["SpawnSeated", "SpawnStanding", "ExitPoint", "NpcAnchorQ", "TeacherAnchorN"]:
		var marker := room.get_node_or_null(marker_name) as Marker3D
		if marker == null:
			continue
		_cross(img, to_px.call(marker.global_position), 11.0, Color(0.64, 0.76, 0.78))

	img.save_png(OUT_DIR.path_join(filename))
	print("Wrote %s (%dx%d)" % [filename, PW, PH])


func _fill_rect(img: Image, a: Vector2, b: Vector2, colour: Color) -> void:
	for y in range(int(clampf(minf(a.y, b.y), 0, img.get_height() - 1)), int(clampf(maxf(a.y, b.y), 0, img.get_height() - 1)) + 1):
		for x in range(int(clampf(minf(a.x, b.x), 0, img.get_width() - 1)), int(clampf(maxf(a.x, b.x), 0, img.get_width() - 1)) + 1):
			img.set_pixel(x, y, img.get_pixel(x, y).blend(colour))


func _ring(img: Image, centre: Vector2, radius: float, colour: Color) -> void:
	for angle in range(0, 360, 5):
		var rad := deg_to_rad(float(angle))
		_plot(img, centre + Vector2(cos(rad), sin(rad)) * radius, colour)


func _cross(img: Image, centre: Vector2, size: float, colour: Color) -> void:
	for d in range(-int(size), int(size) + 1):
		_plot(img, centre + Vector2(d, 0), colour)
		_plot(img, centre + Vector2(0, d), colour)


func _plot(img: Image, p: Vector2, colour: Color) -> void:
	var x := int(p.x)
	var y := int(p.y)
	if x >= 0 and y >= 0 and x < img.get_width() and y < img.get_height():
		img.set_pixel(x, y, colour)
